<Window x:Class="VolenteerHub.Views.AdminDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VolunteerHub - Admin"
        Height="780"
        Width="1250"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F6F9F7">

    <Window.Resources>

        <!-- SIDEBAR -->
        <LinearGradientBrush x:Key="SidebarGradient"
                             StartPoint="0,0"
                             EndPoint="0,1">

            <GradientStop Color="#063F34"
                          Offset="0"/>

            <GradientStop Color="#075D49"
                          Offset="0.55"/>

            <GradientStop Color="#04382D"
                          Offset="1"/>

        </LinearGradientBrush>


        <!-- NAV BUTTON -->
        <Style x:Key="NavButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="Margin"
                    Value="0,0,0,8"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#F1F8F5"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="BackgroundBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="14,0">

                            <ContentPresenter
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="BackgroundBorder"
                                        Property="Background"
                                        Value="#147961"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- PRIMARY BUTTON -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Background"
                    Value="#087A61"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="#05624E"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- CARD -->
        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="CornerRadius"
                    Value="18"/>

            <Setter Property="Effect">

                <Setter.Value>

                    <DropShadowEffect
                        BlurRadius="18"
                        ShadowDepth="3"
                        Opacity="0.07"/>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="250"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- ================================================= -->
        <!-- SIDEBAR                                           -->
        <!-- ================================================= -->

        <Border Background="{StaticResource SidebarGradient}">

            <Grid Margin="20">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <StackPanel>

                    <!-- BRAND -->

                    <StackPanel Margin="5,18,0,35">

                        <StackPanel Orientation="Horizontal">

                            <Border Width="42"
                                    Height="42"
                                    Background="#ECF8F4"
                                    CornerRadius="21"
                                    Margin="0,0,10,0">

                                <TextBlock Text="♥"
                                           FontSize="21"
                                           Foreground="#0A8267"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>


                            <TextBlock Text="VolunteerHub"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                        </StackPanel>


                        <TextBlock Text="Admin Center"
                                   Margin="51,3,0,0"
                                   FontSize="12"
                                   Foreground="#B3D8CE"/>

                    </StackPanel>


                    <!-- DASHBOARD ACTIVE -->

                    <Button Height="48"
                            Margin="0,0,0,8"
                            Background="#16856E"
                            Foreground="White"
                            BorderThickness="0">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="11"
                                        Padding="14,0">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE80F;"
                                                   FontSize="20"
                                                   Width="35"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Text="Admin Dashboard"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>


                    <!-- USERS -->

                    <Button Style="{StaticResource NavButtonStyle}"
                            Click="ManageUsersButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE716;"
                                       FontSize="20"
                                       Width="35"/>

                            <TextBlock Text="Manage Users"/>

                        </StackPanel>

                    </Button>


                    <!-- VERIFICATION -->

                    <Button Style="{StaticResource NavButtonStyle}"
                            Click="VerificationButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE8D7;"
                                       FontSize="20"
                                       Width="35"/>

                            <TextBlock Text="Verification"/>

                        </StackPanel>

                    </Button>


                    <!-- EVENTS -->

                    <Button Style="{StaticResource NavButtonStyle}"
                            Click="ViewEventsButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE721;"
                                       FontSize="20"
                                       Width="35"/>

                            <TextBlock Text="View Events"/>

                        </StackPanel>

                    </Button>

                </StackPanel>


                <!-- LOG OUT -->

                <Button Grid.Row="2"
                        Height="48"
                        Background="#06392E"
                        Foreground="White"
                        BorderBrush="#3D8774"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="LogoutButton_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="LogoutBackground"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE8AC;"
                                               FontSize="18"
                                               Margin="0,0,9,0"/>

                                    <TextBlock Text="Log out"
                                               FontWeight="SemiBold"/>

                                </StackPanel>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver"
                                         Value="True">

                                    <Setter TargetName="LogoutBackground"
                                            Property="Background"
                                            Value="#042E25"/>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Button.Template>

                </Button>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- MAIN                                              -->
        <!-- ================================================= -->

        <Grid Grid.Column="1"
              Margin="34,28,34,28">

            <Grid.RowDefinitions>

                <RowDefinition Height="125"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- HERO -->

            <Border Height="125"
                    CornerRadius="18"
                    ClipToBounds="True">

                <Border.Effect>

                    <DropShadowEffect BlurRadius="18"
                                      ShadowDepth="3"
                                      Opacity="0.09"/>

                </Border.Effect>


                <Grid>

                    <Border>

                        <Border.Background>

                            <ImageBrush ImageSource="/Assets/volunteer.jpg.jpg"
                                        Stretch="UniformToFill"
                                        AlignmentY="Center"/>

                        </Border.Background>

                    </Border>


                    <Border>

                        <Border.Background>

                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,0">

                                <GradientStop Color="#F5064E3B"
                                              Offset="0"/>

                                <GradientStop Color="#C5064E3B"
                                              Offset="0.55"/>

                                <GradientStop Color="#45064E3B"
                                              Offset="1"/>

                            </LinearGradientBrush>

                        </Border.Background>

                    </Border>


                    <StackPanel Margin="30,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Admin Dashboard"
                                   FontSize="31"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock x:Name="AdminWelcomeText"
                                   Text="Manage VolunteerHub users, verification and platform activity."
                                   Margin="1,5,0,0"
                                   FontSize="13"
                                   Foreground="#E7F3EF"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- STATS                                             -->
            <!-- ================================================= -->

            <Grid Grid.Row="1"
                  Margin="0,22,0,22">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="16"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="16"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="16"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- USERS -->

                <Border Grid.Column="0"
                        Height="125"
                        Style="{StaticResource CardStyle}"
                        Padding="20">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="50"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="TOTAL USERS"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#087A61"/>

                            <TextBlock x:Name="TotalUsersText"
                                       Text="0"
                                       Margin="0,8,0,0"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#12382F"/>

                            <TextBlock Text="All registered accounts"
                                       Margin="0,3,0,0"
                                       FontSize="10"
                                       Foreground="#84918D"/>

                        </StackPanel>


                        <Border Grid.Column="1"
                                Width="45"
                                Height="45"
                                CornerRadius="23"
                                Background="#DDF2EA"
                                VerticalAlignment="Center">

                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE716;"
                                       FontSize="20"
                                       Foreground="#087A61"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- VOLUNTEERS -->

                <Border Grid.Column="2"
                        Height="125"
                        Style="{StaticResource CardStyle}"
                        Padding="20">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="50"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="VOLUNTEERS"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#2478A8"/>

                            <TextBlock x:Name="VolunteerCountText"
                                       Text="0"
                                       Margin="0,8,0,0"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#12382F"/>

                            <TextBlock Text="Volunteer accounts"
                                       Margin="0,3,0,0"
                                       FontSize="10"
                                       Foreground="#84918D"/>

                        </StackPanel>


                        <Border Grid.Column="1"
                                Width="45"
                                Height="45"
                                CornerRadius="23"
                                Background="#DCEEF7"
                                VerticalAlignment="Center">

                            <TextBlock Text="♥"
                                       FontSize="20"
                                       Foreground="#2478A8"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- ORGANIZERS -->

                <Border Grid.Column="4"
                        Height="125"
                        Style="{StaticResource CardStyle}"
                        Padding="20">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="50"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="ORGANIZERS"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#C68518"/>

                            <TextBlock x:Name="OrganizerCountText"
                                       Text="0"
                                       Margin="0,8,0,0"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#12382F"/>

                            <TextBlock Text="Organizer accounts"
                                       Margin="0,3,0,0"
                                       FontSize="10"
                                       Foreground="#84918D"/>

                        </StackPanel>


                        <Border Grid.Column="1"
                                Width="45"
                                Height="45"
                                CornerRadius="23"
                                Background="#FFF0D5"
                                VerticalAlignment="Center">

                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE8D4;"
                                       FontSize="20"
                                       Foreground="#C68518"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- PENDING -->

                <Border Grid.Column="6"
                        Height="125"
                        Style="{StaticResource CardStyle}"
                        Padding="20">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="50"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="PENDING VERIFICATION"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#B76A18"/>

                            <TextBlock x:Name="PendingVerificationText"
                                       Text="0"
                                       Margin="0,8,0,0"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#12382F"/>

                            <TextBlock Text="Requests awaiting review"
                                       Margin="0,3,0,0"
                                       FontSize="10"
                                       Foreground="#84918D"/>

                        </StackPanel>


                        <Border Grid.Column="1"
                                Width="45"
                                Height="45"
                                CornerRadius="23"
                                Background="#FFF0D5"
                                VerticalAlignment="Center">

                            <TextBlock Text="!"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#B76A18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>

            </Grid>


            <!-- ================================================= -->
            <!-- ADMIN ACTIONS                                     -->
            <!-- ================================================= -->

            <Border Grid.Row="2"
                    Style="{StaticResource CardStyle}"
                    Padding="25">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <StackPanel>

                        <TextBlock Text="Administration"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#12382F"/>

                        <TextBlock Text="Manage users, verify identities and monitor VolunteerHub."
                                   Margin="0,5,0,0"
                                   FontSize="11"
                                   Foreground="#7D8C86"/>

                    </StackPanel>


                    <Grid Grid.Row="1"
                          Margin="0,22,0,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="18"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="18"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <!-- MANAGE USERS -->

                        <Border Grid.Column="0"
                                Background="#F5FAF8"
                                CornerRadius="15"
                                Padding="22">

                            <StackPanel>

                                <Border Width="48"
                                        Height="48"
                                        CornerRadius="24"
                                        Background="#DDF2EA"
                                        HorizontalAlignment="Left">

                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE716;"
                                               FontSize="22"
                                               Foreground="#087A61"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>


                                <TextBlock Text="Manage Users"
                                           Margin="0,14,0,0"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#12382F"/>

                                <TextBlock Text="View VolunteerHub accounts, roles and account information."
                                           Margin="0,5,0,15"
                                           FontSize="10"
                                           Foreground="#7D8C86"
                                           TextWrapping="Wrap"/>


                                <Button Content="Open user management"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="ManageUsersButton_Click"/>

                            </StackPanel>

                        </Border>


                        <!-- VERIFICATION -->

                        <Border Grid.Column="2"
                                Background="#FFF9EF"
                                CornerRadius="15"
                                Padding="22">

                            <StackPanel>

                                <Border Width="48"
                                        Height="48"
                                        CornerRadius="24"
                                        Background="#FFF0D5"
                                        HorizontalAlignment="Left">

                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE8D7;"
                                               FontSize="22"
                                               Foreground="#C68518"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>


                                <TextBlock Text="Verification Requests"
                                           Margin="0,14,0,0"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#12382F"/>

                                <TextBlock Text="Review pending identity verification requests."
                                           Margin="0,5,0,15"
                                           FontSize="10"
                                           Foreground="#7D8C86"
                                           TextWrapping="Wrap"/>


                                <Button Content="Review requests"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="VerificationButton_Click"/>

                            </StackPanel>

                        </Border>


                        <!-- EVENTS -->

                        <Border Grid.Column="4"
                                Background="#F4F8FA"
                                CornerRadius="15"
                                Padding="22">

                            <StackPanel>

                                <Border Width="48"
                                        Height="48"
                                        CornerRadius="24"
                                        Background="#DCEEF7"
                                        HorizontalAlignment="Left">

                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE721;"
                                               FontSize="22"
                                               Foreground="#2478A8"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>


                                <TextBlock Text="Platform Events"
                                           Margin="0,14,0,0"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#12382F"/>

                                <TextBlock Text="Browse the volunteering events currently available."
                                           Margin="0,5,0,15"
                                           FontSize="10"
                                           Foreground="#7D8C86"
                                           TextWrapping="Wrap"/>


                                <Button Content="View events"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="ViewEventsButton_Click"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>