<Window x:Class="VolenteerHub.Views.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VolunteerHub - Calendar"
        Height="780"
        Width="1250"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F6F9F7">

    <Window.Resources>

        <!-- SIDEBAR -->
        <LinearGradientBrush x:Key="SidebarGradient"
                             StartPoint="0,0"
                             EndPoint="0,1">
            <GradientStop Color="#064E3B" Offset="0"/>
            <GradientStop Color="#075D49" Offset="0.55"/>
            <GradientStop Color="#054333" Offset="1"/>
        </LinearGradientBrush>

        <!-- NAVIGATION -->
        <Style x:Key="NavButtonStyle"
               TargetType="Button">

            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F1F8F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="NavBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="14,0">

                            <ContentPresenter
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="NavBackground"
                                        Property="Background"
                                        Value="#137961"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- PRIMARY BUTTON -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#087A61"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="PrimaryBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="PrimaryBackground"
                                        Property="Background"
                                        Value="#05624E"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- SECONDARY BUTTON -->
        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#DDF2EA"/>
            <Setter Property="Foreground" Value="#075E4B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="SecondaryBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="SecondaryBackground"
                                        Property="Background"
                                        Value="#CBE8DC"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- CARD -->
        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>

            <Setter Property="Effect">
                <Setter.Value>

                    <DropShadowEffect
                        BlurRadius="18"
                        ShadowDepth="3"
                        Opacity="0.07"/>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- CALENDAR DAYS -->
        <Style x:Key="EventCalendarDayButtonStyle"
               TargetType="CalendarDayButton">

            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#263A34"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="1"/>

            <!-- Only Loaded is used. DataContextChanged caused the error. -->
            <EventSetter Event="Loaded"
                         Handler="CalendarDayButton_Loaded"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="BorderBrush"
                            Value="#087A61"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="BorderBrush"
                            Value="#064E3B"/>

                    <Setter Property="BorderThickness"
                            Value="2"/>

                    <Setter Property="FontWeight"
                            Value="Bold"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- DATA GRID -->
        <Style x:Key="CalendarDataGridStyle"
               TargetType="DataGrid">

            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>

            <!-- Makes the table stable and clearly divided -->
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#DEE8E4"/>
            <Setter Property="VerticalGridLinesBrush" Value="#DEE8E4"/>

            <Setter Property="RowHeight" Value="50"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>

        </Style>

        <!-- TABLE HEADER -->
        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background" Value="#EDF6F2"/>
            <Setter Property="Foreground" Value="#40564E"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderBrush" Value="#D8E6E0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

        </Style>

        <!-- TABLE ROW -->
        <Style TargetType="DataGridRow">

            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#243A33"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F3F9F6"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#DDF2E9"/>

                    <Setter Property="Foreground"
                            Value="#173B31"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- TABLE CELL -->
        <Style TargetType="DataGridCell">

            <Setter Property="BorderBrush" Value="#DEE8E4"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

        </Style>

    </Window.Resources>


    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================= -->
        <!-- SIDEBAR                                           -->
        <!-- ================================================= -->

        <Border Background="{StaticResource SidebarGradient}">

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>

                    <!-- LOGO -->
                    <StackPanel Margin="5,18,0,35">

                        <StackPanel Orientation="Horizontal">

                            <Border Width="42"
                                    Height="42"
                                    Background="#ECF8F4"
                                    CornerRadius="21"
                                    Margin="0,0,10,0">

                                <TextBlock Text="♥"
                                           FontSize="21"
                                           Foreground="#0A8267"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <TextBlock Text="VolunteerHub"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                        <TextBlock Text="Make an impact."
                                   Margin="51,3,0,0"
                                   FontSize="12"
                                   Foreground="#B3D8CE"/>

                    </StackPanel>

                    <!-- DASHBOARD -->
                    <Button Style="{StaticResource NavButtonStyle}"
                            Click="DashboardButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE80F;"
                                       FontSize="20"
                                       Width="35"/>

                            <TextBlock Text="Dashboard"/>

                        </StackPanel>

                    </Button>

                    <!-- CALENDAR ACTIVE -->
                    <Button Height="48"
                            Margin="0,0,0,8"
                            Background="#16856E"
                            Foreground="White"
                            BorderThickness="0">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="11"
                                        Padding="14,0">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE787;"
                                                   FontSize="20"
                                                   Width="35"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Text="Calendar"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                    <!-- EVENTS -->
                    <Button Style="{StaticResource NavButtonStyle}"
                            Click="EventsButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE721;"
                                       FontSize="20"
                                       Width="35"/>

                            <TextBlock Text="Events"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

                <!-- BACK -->
                <Button Grid.Row="2"
                        Height="48"
                        Background="#06392E"
                        Foreground="White"
                        BorderBrush="#3D8774"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="DashboardButton_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="BackBackground"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE72B;"
                                               FontSize="18"
                                               Margin="0,0,9,0"/>

                                    <TextBlock Text="Back to dashboard"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>

                                </StackPanel>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver"
                                         Value="True">

                                    <Setter TargetName="BackBackground"
                                            Property="Background"
                                            Value="#042E25"/>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Button.Template>

                </Button>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- MAIN                                              -->
        <!-- ================================================= -->

        <Grid Grid.Column="1"
              Margin="34,28,34,28">

            <Grid.RowDefinitions>
                <RowDefinition Height="125"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HERO -->
            <Border Height="125"
                    CornerRadius="18"
                    ClipToBounds="True">

                <Border.Effect>

                    <DropShadowEffect
                        BlurRadius="18"
                        ShadowDepth="3"
                        Opacity="0.09"/>

                </Border.Effect>

                <Grid>

                    <Border>
                        <Border.Background>

                            <ImageBrush ImageSource="/Assets/kalender.jpg.jpg"
                                        Stretch="UniformToFill"
                                        AlignmentY="Center"/>

                        </Border.Background>
                    </Border>

                    <Border>

                        <Border.Background>

                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,0">

                                <GradientStop Color="#EF064E3B"
                                              Offset="0"/>

                                <GradientStop Color="#BC064E3B"
                                              Offset="0.48"/>

                                <GradientStop Color="#30064E3B"
                                              Offset="1"/>

                            </LinearGradientBrush>

                        </Border.Background>

                    </Border>

                    <StackPanel Margin="30,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Event Calendar"
                                   FontSize="31"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Browse events by month and see which opportunities you already joined."
                                   Margin="1,5,0,0"
                                   FontSize="13"
                                   Foreground="#E7F3EF"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- BODY -->
            <Grid Grid.Row="1"
                  Margin="0,22,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- CALENDAR CARD -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}"
                        Padding="22">

                    <StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,15">

                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="20"
                                    Background="#DDF2EA"
                                    Margin="0,0,11,0">

                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE787;"
                                           FontSize="19"
                                           Foreground="#087A61"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="Select a date"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="#12382F"/>

                                <TextBlock Text="Choose a day to filter events"
                                           FontSize="10"
                                           Foreground="#7B8A85"/>

                            </StackPanel>

                        </StackPanel>


                        <Border Background="#F7FAF8"
                                BorderBrush="#E3ECE8"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="8">

                            <Calendar x:Name="EventCalendar"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Top"
                                      SelectionMode="SingleDate"
                                      DisplayMode="Month"
                                      CalendarDayButtonStyle="{StaticResource EventCalendarDayButtonStyle}"
                                      SelectedDatesChanged="EventCalendar_SelectedDatesChanged"
                                      DisplayDateChanged="EventCalendar_DisplayDateChanged"/>

                        </Border>


                        <!-- LEGEND -->
                        <Border Height="1"
                                Background="#E5ECE9"
                                Margin="0,20,0,16"/>

                        <TextBlock Text="Calendar legend"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#31483F"
                                   Margin="0,0,0,13"/>

                        <!-- JOINED -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,12">

                            <Border Width="15"
                                    Height="15"
                                    CornerRadius="4"
                                    Background="#BFE8D6"
                                    BorderBrush="#087A61"
                                    BorderThickness="1"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"/>

                            <StackPanel>

                                <TextBlock Text="Joined event"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           Foreground="#087A61"/>

                                <TextBlock Text="You are registered on this date"
                                           FontSize="9"
                                           Foreground="#84918D"/>

                            </StackPanel>

                        </StackPanel>

                        <!-- AVAILABLE -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,12">

                            <Border Width="15"
                                    Height="15"
                                    CornerRadius="4"
                                    Background="#FFE4AE"
                                    BorderBrush="#D99523"
                                    BorderThickness="1"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"/>

                            <StackPanel>

                                <TextBlock Text="Available event"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           Foreground="#B9720B"/>

                                <TextBlock Text="Event available, not joined"
                                           FontSize="9"
                                           Foreground="#84918D"/>

                            </StackPanel>

                        </StackPanel>

                        <!-- NO EVENT -->
                        <StackPanel Orientation="Horizontal">

                            <Border Width="15"
                                    Height="15"
                                    CornerRadius="4"
                                    Background="White"
                                    BorderBrush="#D5DEDA"
                                    BorderThickness="1"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"/>

                            <StackPanel>

                                <TextBlock Text="No event"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           Foreground="#53635D"/>

                                <TextBlock Text="No volunteering event"
                                           FontSize="9"
                                           Foreground="#84918D"/>

                            </StackPanel>

                        </StackPanel>

                    </StackPanel>

                </Border>


                <!-- EVENTS TABLE -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="92"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- PHOTO HEADER -->
                        <Border Grid.Row="0"
                                CornerRadius="18,18,0,0"
                                ClipToBounds="True">

                            <Grid>

                                <Border>

                                    <Border.Background>

                                        <ImageBrush ImageSource="/Assets/upcomingEvents.jpg.jpg"
                                                    Stretch="UniformToFill"
                                                    AlignmentY="Center"/>

                                    </Border.Background>

                                </Border>

                                <Border>

                                    <Border.Background>

                                        <LinearGradientBrush StartPoint="0,0"
                                                             EndPoint="1,0">

                                            <GradientStop Color="#EE075D49"
                                                          Offset="0"/>

                                            <GradientStop Color="#AC075D49"
                                                          Offset="0.58"/>

                                            <GradientStop Color="#30075D49"
                                                          Offset="1"/>

                                        </LinearGradientBrush>

                                    </Border.Background>

                                </Border>

                                <StackPanel Margin="24,0,0,0"
                                            VerticalAlignment="Center">

                                    <TextBlock x:Name="MonthTitleText"
                                               Text="Events"
                                               FontSize="21"
                                               FontWeight="Bold"
                                               Foreground="White"/>

                                    <TextBlock x:Name="FilterDescriptionText"
                                               Text="Events for this month"
                                               Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="#E8F5F0"/>

                                </StackPanel>

                            </Grid>

                        </Border>


                        <!-- FIXED TABLE -->
                        <Border Grid.Row="1"
                                Margin="22,18,22,0"
                                BorderBrush="#DDE7E3"
                                BorderThickness="1"
                                Background="White">

                            <DataGrid x:Name="CalendarEventsDataGrid"
                                      AutoGenerateColumns="False"
                                      Style="{StaticResource CalendarDataGridStyle}">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Event"
                                                        Binding="{Binding Title}"
                                                        Width="225"/>

                                    <DataGridTextColumn Header="Date"
                                                        Binding="{Binding EventDate}"
                                                        Width="105"/>

                                    <DataGridTextColumn Header="Time"
                                                        Binding="{Binding StartTime}"
                                                        Width="85"/>

                                    <DataGridTextColumn Header="Category"
                                                        Binding="{Binding Category}"
                                                        Width="120"/>

                                    <DataGridTextColumn Header="Status"
                                                        Binding="{Binding EventStatus}"
                                                        Width="95"/>

                                </DataGrid.Columns>

                            </DataGrid>

                        </Border>


                        <!-- ACTIONS -->
                        <Grid Grid.Row="2"
                              Margin="22,17,22,20">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="#69B792"
                                         Margin="0,0,8,0"/>

                                <TextBlock Text="Select an event to view its details."
                                           FontSize="10"
                                           Foreground="#7B8A85"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Show whole month"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ShowMonthButton_Click"/>

                            <Button Grid.Column="3"
                                    Content="View selected event"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="ViewEventButton_Click"/>

                        </Grid>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Window>