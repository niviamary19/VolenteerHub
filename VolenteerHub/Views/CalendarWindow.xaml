<Window x:Class="VolenteerHub.Views.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VolunteerHub - Calendar"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F7FB">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Background="#1F4F46">

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>

                    <TextBlock Text="VolunteerHub"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,10,0,40"/>

                    <Button Content="Dashboard"
                            Height="45"
                            Margin="0,0,0,10"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Cursor="Hand"
                            Click="DashboardButton_Click"/>

                    <Button Content="Calendar"
                            Height="45"
                            Margin="0,0,0,10"
                            Background="#2E7D6E"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"/>

                    <Button Content="Events"
                            Height="45"
                            Margin="0,0,0,10"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Cursor="Hand"
                            Click="EventsButton_Click"/>

                </StackPanel>

                <Button Grid.Row="2"
                        Content="Back to dashboard"
                        Height="45"
                        Background="#173B35"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="DashboardButton_Click"/>

            </Grid>

        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1"
              Margin="35">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel>

                <TextBlock Text="Event Calendar"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#1F2937"/>

                <TextBlock Text="Browse upcoming and past volunteer events by month."
                           Margin="0,5,0,0"
                           FontSize="15"
                           Foreground="#6B7280"/>

            </StackPanel>

            <!-- CALENDAR + EVENTS -->
            <Grid Grid.Row="1"
                  Margin="0,25,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CALENDAR -->
                <Border Background="White"
                        CornerRadius="15"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Select a date"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="#1F2937"
                                   Margin="0,0,0,15"/>

                        <Calendar x:Name="EventCalendar"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Top"
                                  SelectionMode="SingleDate"
                                  DisplayMode="Month"
                                  SelectedDatesChanged="EventCalendar_SelectedDatesChanged"
                                  DisplayDateChanged="EventCalendar_DisplayDateChanged"/>

                        <Separator Margin="0,20,0,15"/>

                        <TextBlock Text="Legend"
                                   FontWeight="Bold"
                                   Foreground="#374151"/>

                        <TextBlock Text="Upcoming = future event"
                                   Margin="0,8,0,0"
                                   Foreground="#2E7D6E"/>

                        <TextBlock Text="Today = event today"
                                   Margin="0,5,0,0"
                                   Foreground="#6B7280"/>

                        <TextBlock Text="Past = completed date"
                                   Margin="0,5,0,0"
                                   Foreground="#9CA3AF"/>

                    </StackPanel>

                </Border>

                <!-- EVENTS -->
                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="15"
                        Padding="22">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="MonthTitleText"
                                   Text="Events"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#1F2937"/>

                        <TextBlock x:Name="FilterDescriptionText"
                                   Grid.Row="1"
                                   Text="Events for this month"
                                   Margin="0,5,0,18"
                                   Foreground="#6B7280"/>

                        <DataGrid x:Name="CalendarEventsDataGrid"
                                  Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="42">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Event"
                                                    Binding="{Binding Title}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Date"
                                                    Binding="{Binding EventDate}"
                                                    Width="100"/>

                                <DataGridTextColumn Header="Time"
                                                    Binding="{Binding StartTime}"
                                                    Width="80"/>

                                <DataGridTextColumn Header="Category"
                                                    Binding="{Binding Category}"
                                                    Width="110"/>

                                <DataGridTextColumn Header="Status"
                                                    Binding="{Binding EventStatus}"
                                                    Width="90"/>

                            </DataGrid.Columns>

                        </DataGrid>

                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,18,0,0">

                            <Button Content="Show whole month"
                                    Width="150"
                                    Height="40"
                                    Background="#DDEFEA"
                                    Foreground="#1F4F46"
                                    BorderThickness="0"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Click="ShowMonthButton_Click"/>

                            <Button Content="View selected event"
                                    Width="170"
                                    Height="40"
                                    Margin="10,0,0,0"
                                    Background="#2E7D6E"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Click="ViewEventButton_Click"/>

                        </StackPanel>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Window>