<Window x:Class="VolenteerHub.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VolunteerHub - Profile"
        Height="720"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F7FB">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Background="#1F4F46">

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>

                    <TextBlock Text="VolunteerHub"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,10,0,40"/>

                    <Button Content="Dashboard"
                            Height="45"
                            Margin="0,0,0,10"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Cursor="Hand"
                            Click="DashboardButton_Click"/>

                    <Button Content="Events"
                            Height="45"
                            Margin="0,0,0,10"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Cursor="Hand"
                            Click="EventsButton_Click"/>

                    <Button Content="Profile"
                            Height="45"
                            Margin="0,0,0,10"
                            Background="#2E7D6E"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"/>

                </StackPanel>

                <Button Grid.Row="2"
                        Content="Back to dashboard"
                        Height="45"
                        Background="#173B35"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="DashboardButton_Click"/>

            </Grid>

        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto">

            <Grid Margin="35">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>

                    <TextBlock Text="My Profile"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#1F2937"/>

                    <TextBlock Text="Manage your VolunteerHub account and security."
                               Margin="0,5,0,0"
                               FontSize="15"
                               Foreground="#6B7280"/>

                </StackPanel>

                <!-- PROFILE DETAILS -->
                <Border Grid.Row="1"
                        Margin="0,25,0,20"
                        Background="White"
                        CornerRadius="15"
                        Padding="25">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Account details"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#1F2937"
                                       Margin="0,0,0,20"/>

                            <TextBlock Text="Full name"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"/>

                            <TextBox x:Name="FullNameTextBox"
                                     Height="40"
                                     Margin="0,7,0,15"
                                     Padding="10"/>

                            <TextBlock Text="Email"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"/>

                            <TextBox x:Name="EmailTextBox"
                                     Height="40"
                                     Margin="0,7,0,20"
                                     Padding="10"/>

                            <Button Content="Save profile"
                                    Height="42"
                                    Background="#2E7D6E"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="SaveProfileButton_Click"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Account information"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#1F2937"
                                       Margin="0,0,0,20"/>

                            <TextBlock Text="Role"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"/>

                            <TextBlock x:Name="RoleText"
                                       Margin="0,7,0,20"
                                       FontSize="16"
                                       Foreground="#2E7D6E"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Total volunteer hours"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"/>

                            <TextBlock x:Name="TotalHoursText"
                                       Margin="0,7,0,20"
                                       FontSize="16"
                                       Foreground="#1F2937"/>

                            <TextBlock Text="Joined events"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"/>

                            <TextBlock x:Name="JoinedEventsText"
                                       Margin="0,7,0,20"
                                       FontSize="16"
                                       Foreground="#1F2937"/>

                            <TextBlock Text="Account created"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"/>

                            <TextBlock x:Name="CreatedAtText"
                                       Margin="0,7,0,0"
                                       FontSize="14"
                                       Foreground="#6B7280"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <!-- PASSWORD -->
                <Border Grid.Row="2"
                        Background="White"
                        CornerRadius="15"
                        Padding="25"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="Change password"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#1F2937"/>

                        <TextBlock Text="Use at least 6 characters for your new password."
                                   Margin="0,5,0,20"
                                   Foreground="#6B7280"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="Current password"
                                           FontWeight="SemiBold"/>

                                <PasswordBox x:Name="CurrentPasswordInput"
                                             Height="40"
                                             Margin="0,7,0,0"
                                             Padding="10"/>

                            </StackPanel>

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="New password"
                                           FontWeight="SemiBold"/>

                                <PasswordBox x:Name="NewPasswordInput"
                                             Height="40"
                                             Margin="0,7,0,0"
                                             Padding="10"/>

                            </StackPanel>

                            <StackPanel Grid.Column="4">

                                <TextBlock Text="Confirm password"
                                           FontWeight="SemiBold"/>

                                <PasswordBox x:Name="ConfirmPasswordInput"
                                             Height="40"
                                             Margin="0,7,0,0"
                                             Padding="10"/>

                            </StackPanel>

                        </Grid>

                        <Button Content="Change password"
                                Width="180"
                                Height="42"
                                Margin="0,20,0,0"
                                HorizontalAlignment="Left"
                                Background="#1F4F46"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="ChangePasswordButton_Click"/>

                    </StackPanel>

                </Border>

                <!-- DELETE ACCOUNT -->
                <Border Grid.Row="3"
                        Background="White"
                        CornerRadius="15"
                        Padding="25"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Delete account"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#991B1B"/>

                            <TextBlock Text="This permanently removes your account and associated data."
                                       Margin="0,5,0,0"
                                       Foreground="#6B7280"/>

                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Delete account"
                                Width="150"
                                Height="42"
                                Margin="20,0,0,0"
                                Background="#991B1B"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="DeleteAccountButton_Click"/>

                    </Grid>

                </Border>

            </Grid>

        </ScrollViewer>

    </Grid>

</Window>