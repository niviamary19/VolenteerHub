<Window x:Class="VolenteerHub.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VolunteerHub - Profile"
        Height="780"
        Width="1250"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F6F9F7">

    <Window.Resources>

        <LinearGradientBrush x:Key="SidebarGradient"
                             StartPoint="0,0"
                             EndPoint="0,1">
            <GradientStop Color="#064E3B" Offset="0"/>
            <GradientStop Color="#075D49" Offset="0.55"/>
            <GradientStop Color="#054333" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="NavButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F1F8F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="14,0">

                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="NavBackground"
                                        Property="Background"
                                        Value="#137961"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle"
               TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18"
                                      ShadowDepth="3"
                                      Opacity="0.07"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#F8FAF9"/>
            <Setter Property="BorderBrush" Value="#DCE7E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ProfilePasswordStyle"
               TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#F8FAF9"/>
            <Setter Property="BorderBrush" Value="#DCE7E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#087A61"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="#05624E"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBackground"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#E2F2EC"/>
            <Setter Property="Foreground" Value="#075E4B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SecondaryBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="SecondaryBackground"
                                        Property="Background"
                                        Value="#CDE8DD"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="SecondaryBackground"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- SIDEBAR -->
        <Border Background="{StaticResource SidebarGradient}">

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>

                    <StackPanel Margin="5,18,0,35">

                        <StackPanel Orientation="Horizontal">

                            <Border Width="42"
                                    Height="42"
                                    Background="#ECF8F4"
                                    CornerRadius="21"
                                    Margin="0,0,10,0">

                                <TextBlock Text="♥"
                                           FontSize="21"
                                           Foreground="#0A8267"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <TextBlock Text="VolunteerHub"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                        <TextBlock Text="Make an impact."
                                   Margin="51,3,0,0"
                                   FontSize="12"
                                   Foreground="#B3D8CE"/>

                    </StackPanel>


                    <Button Style="{StaticResource NavButtonStyle}"
                            Click="DashboardButton_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE80F;"
                                       FontSize="20"
                                       Width="35"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>

                    </Button>


                    <Button Style="{StaticResource NavButtonStyle}"
                            Click="EventsButton_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE721;"
                                       FontSize="20"
                                       Width="35"/>
                            <TextBlock Text="Events"/>
                        </StackPanel>

                    </Button>


                    <Button Height="48"
                            Margin="0,0,0,8"
                            Background="#16856E"
                            Foreground="White"
                            BorderThickness="0">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="11"
                                        Padding="14,0">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE77B;"
                                                   FontSize="20"
                                                   Width="35"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Text="Profile"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                    </Button>

                </StackPanel>


                <Button Grid.Row="2"
                        Height="48"
                        Background="#06392E"
                        Foreground="White"
                        BorderBrush="#3D8774"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="DashboardButton_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="BackBackground"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE72B;"
                                               FontSize="18"
                                               Margin="0,0,9,0"/>

                                    <TextBlock Text="Back to dashboard"
                                               FontWeight="SemiBold"/>

                                </StackPanel>

                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="BackBackground"
                                            Property="Background"
                                            Value="#042E25"/>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Button.Template>

                </Button>

            </Grid>

        </Border>


        <!-- MAIN -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="34,28,34,30">

                <Grid.RowDefinitions>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- HERO -->
                <Border Height="150"
                        CornerRadius="18"
                        ClipToBounds="True">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18"
                                          ShadowDepth="3"
                                          Opacity="0.09"/>
                    </Border.Effect>

                    <Grid>

                        <Border>
                            <Border.Background>
                                <ImageBrush ImageSource="/Assets/samenwerking.jpg.jpg"
                                            Stretch="UniformToFill"
                                            AlignmentY="Center"/>
                            </Border.Background>
                        </Border>

                        <Border>
                            <Border.Background>

                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="1,0">

                                    <GradientStop Color="#F5064E3B"
                                                  Offset="0"/>

                                    <GradientStop Color="#D0064E3B"
                                                  Offset="0.58"/>

                                    <GradientStop Color="#65064E3B"
                                                  Offset="1"/>

                                </LinearGradientBrush>

                            </Border.Background>
                        </Border>

                        <Grid Margin="28,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="My Profile"
                                           FontSize="31"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                <TextBlock Text="Manage your VolunteerHub account, profile photo, verification and security."
                                           Margin="1,5,0,0"
                                           FontSize="13"
                                           Foreground="#E7F3EF"/>

                            </StackPanel>


                            <!-- PROFILE PHOTO -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <Border Width="92"
                                        Height="92"
                                        CornerRadius="46"
                                        Background="#EFF8F4"
                                        BorderBrush="White"
                                        BorderThickness="4"
                                        ClipToBounds="True">

                                    <Grid>

                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush x:Name="ProfileImageBrush"
                                                            Stretch="UniformToFill"/>
                                            </Ellipse.Fill>
                                        </Ellipse>

                                        <TextBlock x:Name="ProfileIconText"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE77B;"
                                                   FontSize="42"
                                                   Foreground="#087A61"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Grid>

                                </Border>


                                <StackPanel Margin="15,0,0,0"
                                            VerticalAlignment="Center">

                                    <Button Content="Choose profile photo"
                                            Width="155"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ChooseProfilePhotoButton_Click"/>

                                    <Button x:Name="RemoveProfilePhotoButton"
                                            Content="Remove photo"
                                            Width="155"
                                            Height="34"
                                            Margin="0,7,0,0"
                                            Background="White"
                                            Foreground="#315247"
                                            BorderBrush="#D7E5DF"
                                            BorderThickness="1"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Visibility="Collapsed"
                                            Click="RemoveProfilePhotoButton_Click"/>

                                </StackPanel>

                            </StackPanel>

                        </Grid>

                    </Grid>

                </Border>


                <!-- ACCOUNT -->
                <Grid Grid.Row="1"
                      Margin="0,22,0,20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- ACCOUNT DETAILS -->
                    <Border Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            Padding="25">

                        <StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,20">

                                <Border Width="40"
                                        Height="40"
                                        CornerRadius="20"
                                        Background="#DDF2EA"
                                        Margin="0,0,11,0">

                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE70F;"
                                               FontSize="18"
                                               Foreground="#087A61"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel VerticalAlignment="Center">

                                    <TextBlock Text="Account details"
                                               FontSize="19"
                                               FontWeight="Bold"
                                               Foreground="#12382F"/>

                                    <TextBlock Text="Update your personal information"
                                               FontSize="10"
                                               Foreground="#84918D"/>

                                </StackPanel>

                            </StackPanel>


                            <TextBlock Text="Full name"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="#40564E"/>

                            <TextBox x:Name="FullNameTextBox"
                                     Style="{StaticResource ProfileTextBoxStyle}"
                                     Margin="0,7,0,16"/>


                            <TextBlock Text="Email address"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="#40564E"/>

                            <TextBox x:Name="EmailTextBox"
                                     Style="{StaticResource ProfileTextBoxStyle}"
                                     Margin="0,7,0,20"/>


                            <Button Content="Save profile"
                                    Width="150"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="SaveProfileButton_Click"/>

                        </StackPanel>

                    </Border>


                    <!-- ACCOUNT INFO -->
                    <Border Grid.Column="2"
                            Style="{StaticResource CardStyle}"
                            Padding="25">

                        <StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,20">

                                <Border Width="40"
                                        Height="40"
                                        CornerRadius="20"
                                        Background="#E4F1F8"
                                        Margin="0,0,11,0">

                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE946;"
                                               FontSize="18"
                                               Foreground="#2478A8"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel VerticalAlignment="Center">

                                    <TextBlock Text="Account information"
                                               FontSize="19"
                                               FontWeight="Bold"
                                               Foreground="#12382F"/>

                                    <TextBlock Text="Your VolunteerHub overview"
                                               FontSize="10"
                                               Foreground="#84918D"/>

                                </StackPanel>

                            </StackPanel>


                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>


                                <Border Margin="0,0,8,8"
                                        Background="#F5FAF8"
                                        CornerRadius="10"
                                        Padding="14">

                                    <StackPanel>

                                        <TextBlock Text="ROLE"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="#84918D"/>

                                        <TextBlock x:Name="RoleText"
                                                   Margin="0,5,0,0"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="#087A61"/>

                                    </StackPanel>

                                </Border>


                                <Border Grid.Column="1"
                                        Margin="8,0,0,8"
                                        Background="#FFF8E9"
                                        CornerRadius="10"
                                        Padding="14">

                                    <StackPanel>

                                        <TextBlock Text="TOTAL HOURS"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="#B77A1A"/>

                                        <TextBlock x:Name="TotalHoursText"
                                                   Margin="0,5,0,0"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="#12382F"/>

                                    </StackPanel>

                                </Border>


                                <Border Grid.Row="1"
                                        Margin="0,8,8,0"
                                        Background="#F0F7FA"
                                        CornerRadius="10"
                                        Padding="14">

                                    <StackPanel>

                                        <TextBlock Text="JOINED EVENTS"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="#2478A8"/>

                                        <TextBlock x:Name="JoinedEventsText"
                                                   Margin="0,5,0,0"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="#12382F"/>

                                    </StackPanel>

                                </Border>


                                <Border Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="8,8,0,0"
                                        Background="#F5FAF8"
                                        CornerRadius="10"
                                        Padding="14">

                                    <StackPanel>

                                        <TextBlock Text="MEMBER SINCE"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="#84918D"/>

                                        <TextBlock x:Name="CreatedAtText"
                                                   Margin="0,5,0,0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#40564E"
                                                   TextWrapping="Wrap"/>

                                    </StackPanel>

                                </Border>

                            </Grid>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- VERIFICATION + CERTIFICATE                        -->
                <!-- ================================================= -->

                <Border Grid.Row="2"
                        Style="{StaticResource CardStyle}"
                        Padding="25"
                        Margin="0,0,0,20">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <!-- ID VERIFICATION -->
                        <StackPanel Grid.Column="0"
                                    Margin="0,0,25,0">

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,18">

                                <Border Width="42"
                                        Height="42"
                                        CornerRadius="21"
                                        Background="#DDF2EA"
                                        Margin="0,0,12,0">

                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE8D7;"
                                               FontSize="19"
                                               Foreground="#087A61"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel VerticalAlignment="Center">

                                    <TextBlock Text="Identity verification"
                                               FontSize="19"
                                               FontWeight="Bold"
                                               Foreground="#12382F"/>

                                    <TextBlock Text="Verify your identity to become a Verified Volunteer"
                                               FontSize="10"
                                               Foreground="#84918D"/>

                                </StackPanel>

                            </StackPanel>


                            <Border Background="#F6F9F7"
                                    CornerRadius="12"
                                    Padding="16"
                                    Margin="0,0,0,15">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>


                                    <Border x:Name="VerificationStatusBadge"
                                            Width="38"
                                            Height="38"
                                            CornerRadius="19"
                                            Background="#ECEFED"
                                            Margin="0,0,12,0">

                                        <TextBlock x:Name="VerificationStatusIcon"
                                                   Text="?"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#66736E"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>


                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">

                                        <TextBlock x:Name="VerificationStatusText"
                                                   Text="Not verified"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#52615C"/>

                                        <TextBlock x:Name="VerificationDescriptionText"
                                                   Text="Submit an identity document to start verification."
                                                   Margin="0,3,0,0"
                                                   FontSize="10"
                                                   Foreground="#84918D"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock x:Name="VerifiedAtText"
                                                   Text=""
                                                   Margin="0,3,0,0"
                                                   FontSize="10"
                                                   Foreground="#087A61"
                                                   Visibility="Collapsed"/>

                                    </StackPanel>

                                </Grid>

                            </Border>


                            <Button x:Name="ChooseIdDocumentButton"
                                    Content="Choose ID document"
                                    Width="180"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="ChooseIdDocumentButton_Click"/>


                            <TextBlock Text="For this project, the selected ID file is not permanently stored. Only the verification status is saved."
                                       Margin="0,10,0,0"
                                       FontSize="9"
                                       Foreground="#84918D"
                                       TextWrapping="Wrap"/>

                        </StackPanel>


                        <!-- DIVIDER -->
                        <Border Grid.Column="1"
                                Width="1"
                                Background="#E4ECE8"
                                Margin="0,0,0,0"/>


                        <!-- CERTIFICATE -->
                        <StackPanel Grid.Column="2"
                                    Margin="25,0,0,0">

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,18">

                                <Border Width="42"
                                        Height="42"
                                        CornerRadius="21"
                                        Background="#FFF0D5"
                                        Margin="0,0,12,0">

                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE8A1;"
                                               FontSize="19"
                                               Foreground="#D58A18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel VerticalAlignment="Center">

                                    <TextBlock Text="Volunteer certificate"
                                               FontSize="19"
                                               FontWeight="Bold"
                                               Foreground="#12382F"/>

                                    <TextBlock Text="Generate proof of your volunteering impact"
                                               FontSize="10"
                                               Foreground="#84918D"/>

                                </StackPanel>

                            </StackPanel>


                            <Border Background="#F8FAF9"
                                    CornerRadius="12"
                                    Padding="16"
                                    Margin="0,0,0,15">

                                <StackPanel>

                                    <TextBlock Text="Your certificate will contain:"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#40564E"/>

                                    <TextBlock Text="• Full name"
                                               Margin="0,8,0,0"
                                               FontSize="10"
                                               Foreground="#66756F"/>

                                    <TextBlock Text="• Verified Volunteer status"
                                               Margin="0,4,0,0"
                                               FontSize="10"
                                               Foreground="#66756F"/>

                                    <TextBlock Text="• Total volunteer hours"
                                               Margin="0,4,0,0"
                                               FontSize="10"
                                               Foreground="#66756F"/>

                                    <TextBlock Text="• Joined volunteer events"
                                               Margin="0,4,0,0"
                                               FontSize="10"
                                               Foreground="#66756F"/>

                                </StackPanel>

                            </Border>


                            <Button x:Name="GenerateCertificateButton"
                                    Content="Generate Certificate"
                                    Width="190"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    IsEnabled="False"
                                    Click="GenerateCertificateButton_Click"/>

                            <TextBlock x:Name="CertificateLockText"
                                       Text="Verify your identity first to unlock your certificate."
                                       Margin="0,9,0,0"
                                       FontSize="9"
                                       Foreground="#A17624"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- PASSWORD -->
                <Border Grid.Row="3"
                        Style="{StaticResource CardStyle}"
                        Padding="25"
                        Margin="0,0,0,20">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <StackPanel Orientation="Horizontal">

                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="20"
                                    Background="#FFF0D5"
                                    Margin="0,0,11,0">

                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE72E;"
                                           FontSize="18"
                                           Foreground="#D58A18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="Change password"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="#12382F"/>

                                <TextBlock Text="Use at least 6 characters for your new password."
                                           FontSize="10"
                                           Foreground="#84918D"/>

                            </StackPanel>

                        </StackPanel>


                        <Grid Grid.Row="1"
                              Margin="0,20,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock Text="Current password"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Foreground="#40564E"/>

                                <PasswordBox x:Name="CurrentPasswordInput"
                                             Style="{StaticResource ProfilePasswordStyle}"
                                             Margin="0,7,0,0"/>

                            </StackPanel>


                            <StackPanel Grid.Column="2">

                                <TextBlock Text="New password"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Foreground="#40564E"/>

                                <PasswordBox x:Name="NewPasswordInput"
                                             Style="{StaticResource ProfilePasswordStyle}"
                                             Margin="0,7,0,0"/>

                            </StackPanel>


                            <StackPanel Grid.Column="4">

                                <TextBlock Text="Confirm password"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Foreground="#40564E"/>

                                <PasswordBox x:Name="ConfirmPasswordInput"
                                             Style="{StaticResource ProfilePasswordStyle}"
                                             Margin="0,7,0,0"/>

                            </StackPanel>

                        </Grid>


                        <Button Grid.Row="2"
                                Content="Change password"
                                Width="170"
                                HorizontalAlignment="Left"
                                Margin="0,20,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="ChangePasswordButton_Click"/>

                    </Grid>

                </Border>


                <!-- DELETE -->
                <Border Grid.Row="4"
                        Background="#FFF8F8"
                        CornerRadius="15"
                        Padding="22"
                        BorderBrush="#F3D1D1"
                        BorderThickness="1">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <StackPanel Orientation="Horizontal">

                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="20"
                                    Background="#FDE8E8"
                                    Margin="0,0,12,0">

                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE74D;"
                                           FontSize="18"
                                           Foreground="#A52828"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="Delete account"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#991B1B"/>

                                <TextBlock Text="This permanently removes your account and associated data."
                                           Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="#7B6464"/>

                            </StackPanel>

                        </StackPanel>


                        <Button Grid.Column="1"
                                Content="Delete account"
                                Width="145"
                                Height="42"
                                Margin="20,0,0,0"
                                Background="#A52828"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="DeleteAccountButton_Click"/>

                    </Grid>

                </Border>

            </Grid>

        </ScrollViewer>

    </Grid>

</Window>