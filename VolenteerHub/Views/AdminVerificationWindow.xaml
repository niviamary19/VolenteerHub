<Window x:Class="VolenteerHub.Views.AdminVerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VolunteerHub - Verification Requests"
        Height="780"
        Width="1250"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F6F9F7">

    <Window.Resources>

        <LinearGradientBrush x:Key="SidebarGradient"
                             StartPoint="0,0"
                             EndPoint="0,1">

            <GradientStop Color="#063F34"
                          Offset="0"/>

            <GradientStop Color="#075D49"
                          Offset="0.55"/>

            <GradientStop Color="#04382D"
                          Offset="1"/>

        </LinearGradientBrush>


        <Style x:Key="NavButtonStyle"
               TargetType="Button">

            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F1F8F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="NavBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="14,0">

                            <ContentPresenter
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="NavBackground"
                                        Property="Background"
                                        Value="#147961"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#087A61"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="#05624E"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="CornerRadius"
                    Value="18"/>

            <Setter Property="Effect">

                <Setter.Value>

                    <DropShadowEffect
                        BlurRadius="18"
                        ShadowDepth="3"
                        Opacity="0.07"/>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- DATA GRID -->

        <Style x:Key="AdminDataGridStyle"
               TargetType="DataGrid">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="GridLinesVisibility"
                    Value="All"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="#DEE8E4"/>

            <Setter Property="VerticalGridLinesBrush"
                    Value="#DEE8E4"/>

            <Setter Property="RowHeight"
                    Value="52"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="CanUserAddRows"
                    Value="False"/>

            <Setter Property="CanUserResizeRows"
                    Value="False"/>

            <Setter Property="CanUserResizeColumns"
                    Value="False"/>

            <Setter Property="CanUserReorderColumns"
                    Value="False"/>

            <Setter Property="IsReadOnly"
                    Value="True"/>

            <Setter Property="SelectionMode"
                    Value="Single"/>

            <Setter Property="SelectionUnit"
                    Value="FullRow"/>

        </Style>


        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#EDF6F2"/>

            <Setter Property="Foreground"
                    Value="#40564E"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="BorderBrush"
                    Value="#D8E6E0"/>

            <Setter Property="BorderThickness"
                    Value="0,0,1,1"/>

        </Style>


        <Style TargetType="DataGridRow">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#243A33"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F3F9F6"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#DDF2E9"/>

                    <Setter Property="Foreground"
                            Value="#173B31"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>


    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="250"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- ================================================= -->
        <!-- SIDEBAR                                           -->
        <!-- ================================================= -->

        <Border Background="{StaticResource SidebarGradient}">

            <Grid Margin="20">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <StackPanel>

                    <!-- BRAND -->

                    <StackPanel Margin="5,18,0,35">

                        <StackPanel Orientation="Horizontal">

                            <Border Width="42"
                                    Height="42"
                                    Background="#ECF8F4"
                                    CornerRadius="21"
                                    Margin="0,0,10,0">

                                <TextBlock Text="♥"
                                           FontSize="21"
                                           Foreground="#0A8267"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>


                            <TextBlock Text="VolunteerHub"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                        </StackPanel>


                        <TextBlock Text="Admin Center"
                                   Margin="51,3,0,0"
                                   FontSize="12"
                                   Foreground="#B3D8CE"/>

                    </StackPanel>


                    <!-- ADMIN DASHBOARD -->

                    <Button Style="{StaticResource NavButtonStyle}"
                            Click="DashboardButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE80F;"
                                       FontSize="20"
                                       Width="35"/>

                            <TextBlock Text="Admin Dashboard"/>

                        </StackPanel>

                    </Button>


                    <!-- VERIFICATION ACTIVE -->

                    <Button Height="48"
                            Margin="0,0,0,8"
                            Background="#16856E"
                            Foreground="White"
                            BorderThickness="0">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="11"
                                        Padding="14,0">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE8D7;"
                                                   FontSize="20"
                                                   Width="35"/>

                                        <TextBlock Text="Verification"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                </StackPanel>


                <!-- BACK -->

                <Button Grid.Row="2"
                        Height="48"
                        Background="#06392E"
                        Foreground="White"
                        BorderBrush="#3D8774"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="DashboardButton_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE72B;"
                                               FontSize="18"
                                               Margin="0,0,9,0"/>

                                    <TextBlock Text="Back to dashboard"
                                               FontWeight="SemiBold"/>

                                </StackPanel>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- MAIN                                              -->
        <!-- ================================================= -->

        <Grid Grid.Column="1"
              Margin="34,28,34,28">

            <Grid.RowDefinitions>

                <RowDefinition Height="125"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- HERO -->

            <Border Height="125"
                    CornerRadius="18"
                    ClipToBounds="True">

                <Border.Effect>

                    <DropShadowEffect
                        BlurRadius="18"
                        ShadowDepth="3"
                        Opacity="0.09"/>

                </Border.Effect>


                <Grid>

                    <Border>

                        <Border.Background>

                            <ImageBrush ImageSource="/Assets/volunteer.jpg.jpg"
                                        Stretch="UniformToFill"
                                        AlignmentY="Center"/>

                        </Border.Background>

                    </Border>


                    <Border>

                        <Border.Background>

                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,0">

                                <GradientStop Color="#F5064E3B"
                                              Offset="0"/>

                                <GradientStop Color="#C5064E3B"
                                              Offset="0.55"/>

                                <GradientStop Color="#45064E3B"
                                              Offset="1"/>

                            </LinearGradientBrush>

                        </Border.Background>

                    </Border>


                    <StackPanel Margin="30,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Verification Requests"
                                   FontSize="31"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Review pending volunteer identity verification requests."
                                   Margin="1,5,0,0"
                                   FontSize="13"
                                   Foreground="#E7F3EF"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- REQUESTS CARD -->

            <Border Grid.Row="1"
                    Margin="0,22,0,0"
                    Style="{StaticResource CardStyle}"
                    Padding="24">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- TITLE -->

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel>

                            <TextBlock Text="Pending requests"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#12382F"/>

                            <TextBlock Text="Select a volunteer before approving or rejecting a request."
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="#84918D"/>

                        </StackPanel>


                        <Border Grid.Column="1"
                                Background="#FFF0D5"
                                CornerRadius="16"
                                Padding="13,7">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="Pending: "
                                           FontSize="11"
                                           Foreground="#8B6A2B"/>

                                <TextBlock x:Name="PendingCountText"
                                           Text="0"
                                           FontWeight="Bold"
                                           FontSize="11"
                                           Foreground="#B76A18"/>

                            </StackPanel>

                        </Border>

                    </Grid>


                    <!-- TABLE -->

                    <Border Grid.Row="1"
                            Margin="0,20,0,0"
                            BorderBrush="#DDE7E3"
                            BorderThickness="1">

                        <DataGrid x:Name="VerificationDataGrid"
                                  AutoGenerateColumns="False"
                                  Style="{StaticResource AdminDataGridStyle}">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="User ID"
                                                    Binding="{Binding UserId}"
                                                    Width="80"/>

                                <DataGridTextColumn Header="Full name"
                                                    Binding="{Binding FullName}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Email"
                                                    Binding="{Binding Email}"
                                                    Width="240"/>

                                <DataGridTextColumn Header="Role"
                                                    Binding="{Binding Role}"
                                                    Width="120"/>

                                <DataGridTextColumn Header="Status"
                                                    Binding="{Binding VerificationStatus}"
                                                    Width="140"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Border>


                    <!-- ACTIONS -->

                    <Grid Grid.Row="2"
                          Margin="0,18,0,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="150"/>

                            <ColumnDefinition Width="10"/>

                            <ColumnDefinition Width="150"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="#E3A139"
                                     Margin="0,0,8,0"/>

                            <TextBlock Text="Only approve a request after you are satisfied with the verification."
                                       FontSize="10"
                                       Foreground="#7D8C86"
                                       VerticalAlignment="Center"/>

                        </StackPanel>


                        <!-- REJECT -->

                        <Button Grid.Column="1"
                                Content="Reject"
                                Height="42"
                                Background="#FDE8E8"
                                Foreground="#991B1B"
                                BorderBrush="#F1C8C8"
                                BorderThickness="1"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="RejectButton_Click"/>


                        <!-- APPROVE -->

                        <Button Grid.Column="3"
                                Content="Approve"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="ApproveButton_Click"/>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>