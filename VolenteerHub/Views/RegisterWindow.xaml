<Window x:Class="VolenteerHub.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VolunteerHub - Register"
        Height="700"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F7FB">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="0.9*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE -->
        <Border Background="#2E7D6E">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Width="360">

                <TextBlock Text="VolunteerHub"
                           FontSize="42"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Start making a difference."
                           Margin="0,15,0,0"
                           FontSize="20"
                           Foreground="#DDEFEA"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Create your account, discover volunteering opportunities and track your impact."
                           Margin="0,25,0,0"
                           FontSize="15"
                           Foreground="White"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- RIGHT SIDE -->
        <Grid Grid.Column="1">

            <Border Width="370"
                    Padding="35"
                    Background="White"
                    CornerRadius="18"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="Create account"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#1F2937"/>

                    <TextBlock Text="Join the VolunteerHub community"
                               Margin="0,7,0,25"
                               Foreground="#6B7280"/>

                    <TextBlock Text="Full name"
                               FontWeight="SemiBold"/>

                    <TextBox x:Name="NameTextBox"
                             Height="40"
                             Margin="0,7,0,15"
                             Padding="10"/>

                    <TextBlock Text="Email"
                               FontWeight="SemiBold"/>

                    <TextBox x:Name="EmailTextBox"
                             Height="40"
                             Margin="0,7,0,15"
                             Padding="10"/>

                    <TextBlock Text="Password"
                               FontWeight="SemiBold"/>

                    <PasswordBox x:Name="PasswordInput"
                                 Height="40"
                                 Margin="0,7,0,15"
                                 Padding="10"/>

                    <TextBlock Text="Confirm password"
                               FontWeight="SemiBold"/>

                    <PasswordBox x:Name="ConfirmPasswordInput"
                                 Height="40"
                                 Margin="0,7,0,15"
                                 Padding="10"/>

                    <TextBlock Text="I want to join as"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="RoleComboBox"
                              Height="40"
                              Margin="0,7,0,25"
                              SelectedIndex="0">

                        <ComboBoxItem Content="Volunteer"/>
                        <ComboBoxItem Content="Organizer"/>

                    </ComboBox>

                    <Button Content="Create account"
                            Height="45"
                            Background="#2E7D6E"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="RegisterButton_Click"/>

                    <Button Content="Already have an account? Log in"
                            Margin="0,18,0,0"
                            Background="Transparent"
                            Foreground="#2E7D6E"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Click="BackToLogin_Click"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>