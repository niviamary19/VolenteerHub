<Window x:Class="VolenteerHub.Views.MyHoursWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VolunteerHub - My Hours"
        Height="780"
        Width="1250"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F6F9F7">

    <Window.Resources>

        <!-- SIDEBAR -->
        <LinearGradientBrush x:Key="SidebarGradient"
                             StartPoint="0,0"
                             EndPoint="0,1">
            <GradientStop Color="#064E3B" Offset="0"/>
            <GradientStop Color="#075D49" Offset="0.55"/>
            <GradientStop Color="#054333" Offset="1"/>
        </LinearGradientBrush>

        <!-- NAV -->
        <Style x:Key="NavButtonStyle"
               TargetType="Button">

            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F1F8F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="NavBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="14,0">

                            <ContentPresenter
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="NavBackground"
                                        Property="Background"
                                        Value="#137961"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- CARD -->
        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>

            <Setter Property="Effect">
                <Setter.Value>

                    <DropShadowEffect
                        BlurRadius="18"
                        ShadowDepth="3"
                        Opacity="0.07"/>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- DATAGRID -->
        <Style x:Key="HoursDataGridStyle"
               TargetType="DataGrid">

            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#DEE8E4"/>
            <Setter Property="VerticalGridLinesBrush" Value="#DEE8E4"/>
            <Setter Property="RowHeight" Value="50"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>

        </Style>

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background" Value="#EDF6F2"/>
            <Setter Property="Foreground" Value="#40564E"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderBrush" Value="#D8E6E0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

        </Style>

        <Style TargetType="DataGridRow">

            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#243A33"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F3F9F6"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#DDF2E9"/>

                    <Setter Property="Foreground"
                            Value="#173B31"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <Style TargetType="DataGridCell">

            <Setter Property="BorderBrush" Value="#DEE8E4"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

        </Style>

    </Window.Resources>


    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- SIDEBAR -->
        <Border Background="{StaticResource SidebarGradient}">

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>

                    <!-- BRAND -->
                    <StackPanel Margin="5,18,0,35">

                        <StackPanel Orientation="Horizontal">

                            <Border Width="42"
                                    Height="42"
                                    Background="#ECF8F4"
                                    CornerRadius="21"
                                    Margin="0,0,10,0">

                                <TextBlock Text="♥"
                                           FontSize="21"
                                           Foreground="#0A8267"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <TextBlock Text="VolunteerHub"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                        <TextBlock Text="Make an impact."
                                   Margin="51,3,0,0"
                                   FontSize="12"
                                   Foreground="#B3D8CE"/>

                    </StackPanel>

                    <!-- DASHBOARD -->
                    <Button Style="{StaticResource NavButtonStyle}"
                            Click="DashboardButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE80F;"
                                       FontSize="20"
                                       Width="35"/>

                            <TextBlock Text="Dashboard"/>

                        </StackPanel>

                    </Button>

                    <!-- EVENTS -->
                    <Button Style="{StaticResource NavButtonStyle}"
                            Click="EventsButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE721;"
                                       FontSize="20"
                                       Width="35"/>

                            <TextBlock Text="Events"/>

                        </StackPanel>

                    </Button>

                    <!-- MY HOURS ACTIVE -->
                    <Button Height="48"
                            Margin="0,0,0,8"
                            Background="#16856E"
                            Foreground="White"
                            BorderThickness="0">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="11"
                                        Padding="14,0">

                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">

                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE823;"
                                                   FontSize="20"
                                                   Width="35"/>

                                        <TextBlock Text="My Hours"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                </StackPanel>


                <!-- BACK -->
                <Button Grid.Row="2"
                        Height="48"
                        Background="#06392E"
                        Foreground="White"
                        BorderBrush="#3D8774"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="DashboardButton_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="BackBackground"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE72B;"
                                               FontSize="18"
                                               Margin="0,0,9,0"/>

                                    <TextBlock Text="Back to dashboard"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>

                                </StackPanel>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver"
                                         Value="True">

                                    <Setter TargetName="BackBackground"
                                            Property="Background"
                                            Value="#042E25"/>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Button.Template>

                </Button>

            </Grid>

        </Border>


        <!-- MAIN -->
        <Grid Grid.Column="1"
              Margin="34,28,34,28">

            <Grid.RowDefinitions>
                <RowDefinition Height="125"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- HERO -->
            <Border Height="125"
                    CornerRadius="18"
                    ClipToBounds="True">

                <Border.Effect>

                    <DropShadowEffect
                        BlurRadius="18"
                        ShadowDepth="3"
                        Opacity="0.09"/>

                </Border.Effect>

                <Grid>

                    <Border>

                        <Border.Background>

                            <ImageBrush ImageSource="/Assets/samenwerking.jpg.jpg"
                                        Stretch="UniformToFill"
                                        AlignmentY="Center"/>

                        </Border.Background>

                    </Border>

                    <Border>

                        <Border.Background>

                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,0">

                                <GradientStop Color="#EF064E3B"
                                              Offset="0"/>

                                <GradientStop Color="#B9064E3B"
                                              Offset="0.52"/>

                                <GradientStop Color="#2A064E3B"
                                              Offset="1"/>

                            </LinearGradientBrush>

                        </Border.Background>

                    </Border>

                    <StackPanel Margin="30,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="My Volunteering"
                                   FontSize="31"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Track your registered events, total impact and volunteer hours."
                                   Margin="1,5,0,0"
                                   FontSize="13"
                                   Foreground="#E7F3EF"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- SUMMARY -->
            <Grid Grid.Row="1"
                  Margin="0,22,0,22">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- TOTAL HOURS -->
                <Border Grid.Column="0"
                        Height="125"
                        Style="{StaticResource CardStyle}"
                        Padding="22">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="TOTAL HOURS"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#D58A18"/>

                            <TextBlock x:Name="TotalHoursText"
                                       Text="0 h"
                                       Margin="0,8,0,0"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#12382F"/>

                            <TextBlock Text="Your recorded volunteer time"
                                       Margin="0,3,0,0"
                                       FontSize="10"
                                       Foreground="#84918D"/>

                        </StackPanel>

                        <Border Grid.Column="1"
                                Width="48"
                                Height="48"
                                CornerRadius="24"
                                Background="#FFF0D5"
                                VerticalAlignment="Center">

                            <TextBlock Text="★"
                                       FontSize="22"
                                       Foreground="#E39A25"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- JOINED -->
                <Border Grid.Column="2"
                        Height="125"
                        Style="{StaticResource CardStyle}"
                        Padding="22">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="JOINED EVENTS"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#087A61"/>

                            <TextBlock x:Name="JoinedEventsText"
                                       Text="0"
                                       Margin="0,8,0,0"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#12382F"/>

                            <TextBlock Text="Events you registered for"
                                       Margin="0,3,0,0"
                                       FontSize="10"
                                       Foreground="#84918D"/>

                        </StackPanel>

                        <Border Grid.Column="1"
                                Width="48"
                                Height="48"
                                CornerRadius="24"
                                Background="#DDF2EA"
                                VerticalAlignment="Center">

                            <TextBlock Text="✓"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#087A61"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- UPCOMING -->
                <Border Grid.Column="4"
                        Height="125"
                        Style="{StaticResource CardStyle}"
                        Padding="22">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="UPCOMING"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#2478A8"/>

                            <TextBlock x:Name="UpcomingEventsText"
                                       Text="0"
                                       Margin="0,8,0,0"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#12382F"/>

                            <TextBlock Text="Events still ahead"
                                       Margin="0,3,0,0"
                                       FontSize="10"
                                       Foreground="#84918D"/>

                        </StackPanel>

                        <Border Grid.Column="1"
                                Width="48"
                                Height="48"
                                CornerRadius="24"
                                Background="#DCEEF7"
                                VerticalAlignment="Center">

                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE787;"
                                       FontSize="20"
                                       Foreground="#2478A8"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>

            </Grid>


            <!-- TABLE CARD -->
            <Border Grid.Row="2"
                    Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="92"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- PHOTO BAR -->
                    <Border Grid.Row="0"
                            CornerRadius="18,18,0,0"
                            ClipToBounds="True">

                        <Grid>

                            <Border>

                                <Border.Background>

                                    <ImageBrush ImageSource="/Assets/joinedEvent.jpg.jpg"
                                                Stretch="UniformToFill"
                                                AlignmentY="Center"/>

                                </Border.Background>

                            </Border>

                            <Border>

                                <Border.Background>

                                    <LinearGradientBrush StartPoint="0,0"
                                                         EndPoint="1,0">

                                        <GradientStop Color="#EE075D49"
                                                      Offset="0"/>

                                        <GradientStop Color="#AB075D49"
                                                      Offset="0.58"/>

                                        <GradientStop Color="#30075D49"
                                                      Offset="1"/>

                                    </LinearGradientBrush>

                                </Border.Background>

                            </Border>

                            <StackPanel Margin="24,0,0,0"
                                        VerticalAlignment="Center">

                                <TextBlock x:Name="EventsTitleText"
                                           Text="My events"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                <TextBlock Text="Your registered events and recorded volunteer hours."
                                           Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="#E8F5F0"/>

                            </StackPanel>

                        </Grid>

                    </Border>


                    <!-- STABLE TABLE -->
                    <Border Grid.Row="1"
                            Margin="22,18,22,22"
                            BorderBrush="#DDE7E3"
                            BorderThickness="1"
                            Background="White">

                        <DataGrid x:Name="MyEventsDataGrid"
                                  AutoGenerateColumns="False"
                                  Style="{StaticResource HoursDataGridStyle}">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Event"
                                                    Binding="{Binding Title}"
                                                    Width="190"/>

                                <DataGridTextColumn Header="Date"
                                                    Binding="{Binding EventDate}"
                                                    Width="100"/>

                                <DataGridTextColumn Header="Start"
                                                    Binding="{Binding StartTime}"
                                                    Width="80"/>

                                <DataGridTextColumn Header="Location"
                                                    Binding="{Binding Location}"
                                                    Width="155"/>

                                <DataGridTextColumn Header="Category"
                                                    Binding="{Binding Category}"
                                                    Width="110"/>

                                <DataGridTextColumn Header="Status"
                                                    Binding="{Binding EventStatus}"
                                                    Width="100"/>

                                <DataGridTextColumn Header="Hours"
                                                    Binding="{Binding HoursDisplay}"
                                                    Width="80"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Border>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>