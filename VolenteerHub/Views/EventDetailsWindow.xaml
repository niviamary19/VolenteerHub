<Window x:Class="VolenteerHub.Views.EventDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VolunteerHub - Event Details"
        Height="740"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F7FB">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#1F4F46">

            <StackPanel Margin="30"
                        VerticalAlignment="Center">

                <TextBlock Text="VolunteerHub"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,30"/>

                <TextBlock Text="Event details"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#DDEFEA"
                           Margin="0,0,0,15"/>

                <TextBlock Text="Learn more about this volunteering opportunity and view the exact location on Google Maps."
                           Foreground="White"
                           FontSize="15"
                           TextWrapping="Wrap"
                           LineHeight="23"/>

            </StackPanel>

        </Border>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto">

            <Border Width="620"
                    Margin="35"
                    Padding="35"
                    Background="White"
                    CornerRadius="18"
                    HorizontalAlignment="Center">

                <StackPanel>

                    <TextBlock x:Name="TitleText"
                               Text="Event title"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#1F2937"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="CategoryText"
                               Text="Category"
                               Margin="0,8,0,25"
                               Foreground="#2E7D6E"
                               FontWeight="SemiBold"
                               FontSize="15"/>

                    <Separator Margin="0,0,0,22"/>

                    <TextBlock Text="Description"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#1F2937"/>

                    <TextBlock x:Name="DescriptionText"
                               Margin="0,8,0,25"
                               Foreground="#4B5563"
                               TextWrapping="Wrap"
                               LineHeight="22"/>

                    <Grid Margin="0,0,0,20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Date"
                                       FontWeight="Bold"
                                       Foreground="#374151"/>

                            <TextBlock x:Name="DateText"
                                       Margin="0,5,0,0"
                                       Foreground="#6B7280"/>

                        </StackPanel>

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="Time"
                                       FontWeight="Bold"
                                       Foreground="#374151"/>

                            <TextBlock x:Name="TimeText"
                                       Margin="0,5,0,0"
                                       Foreground="#6B7280"/>

                        </StackPanel>

                    </Grid>

                    <Grid Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Location"
                                       FontWeight="Bold"
                                       Foreground="#374151"/>

                            <TextBlock x:Name="LocationText"
                                       Margin="0,5,0,0"
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="Coordinates"
                                       FontWeight="Bold"
                                       Foreground="#374151"/>

                            <TextBlock x:Name="CoordinatesText"
                                       Margin="0,5,0,0"
                                       Foreground="#6B7280"/>

                        </StackPanel>

                    </Grid>

                    <Button Content="View location on Google Maps"
                            Height="42"
                            Margin="0,8,0,22"
                            Background="#DDEFEA"
                            Foreground="#1F4F46"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="ViewMapButton_Click"/>

                    <Border Background="#F4F7FB"
                            CornerRadius="10"
                            Padding="18"
                            Margin="0,5,0,22">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="Available places"
                                           FontWeight="Bold"
                                           Foreground="#374151"/>

                                <TextBlock Text="Current registrations for this event"
                                           FontSize="12"
                                           Margin="0,4,0,0"
                                           Foreground="#6B7280"/>

                            </StackPanel>

                            <TextBlock x:Name="PlacesText"
                                       Grid.Column="1"
                                       Text="0 / 0"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#2E7D6E"
                                       VerticalAlignment="Center"/>

                        </Grid>

                    </Border>

                    <TextBlock x:Name="StatusText"
                               Text=""
                               Margin="0,0,0,12"
                               FontWeight="SemiBold"
                               Foreground="#2E7D6E"
                               TextAlignment="Center"/>

                    <Button x:Name="SignUpButton"
                            Content="Sign up for this event"
                            Height="46"
                            Background="#2E7D6E"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="SignUpButton_Click"/>

                    <Button x:Name="CancelRegistrationButton"
                            Content="Cancel registration"
                            Height="44"
                            Margin="0,10,0,0"
                            Background="#FEE2E2"
                            Foreground="#991B1B"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Click="CancelRegistrationButton_Click"/>

                    <Button Content="Back to events"
                            Height="42"
                            Margin="0,10,0,0"
                            Background="Transparent"
                            Foreground="#6B7280"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BackButton_Click"/>

                </StackPanel>

            </Border>

        </ScrollViewer>

    </Grid>

</Window>