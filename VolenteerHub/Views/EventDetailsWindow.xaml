<Window x:Class="VolenteerHub.Views.EventDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VolunteerHub - Event Details"
        Height="780"
        Width="1250"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F6F9F7">

    <Window.Resources>

        <LinearGradientBrush x:Key="SidebarGradient"
                             StartPoint="0,0"
                             EndPoint="0,1">
            <GradientStop Color="#064E3B" Offset="0"/>
            <GradientStop Color="#075D49" Offset="0.55"/>
            <GradientStop Color="#054333" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="NavButtonStyle"
               TargetType="Button">

            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F1F8F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="NavBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="14,0">

                            <ContentPresenter
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="NavBackground"
                                        Property="Background"
                                        Value="#137961"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#087A61"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="PrimaryBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="PrimaryBackground"
                                        Property="Background"
                                        Value="#05624E"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>

            <Setter Property="Effect">
                <Setter.Value>

                    <DropShadowEffect
                        BlurRadius="18"
                        ShadowDepth="3"
                        Opacity="0.07"/>

                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>


    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- SIDEBAR -->
        <Border Background="{StaticResource SidebarGradient}">

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <StackPanel>

                    <StackPanel Margin="5,18,0,35">

                        <StackPanel Orientation="Horizontal">

                            <Border Width="42"
                                    Height="42"
                                    Background="#ECF8F4"
                                    CornerRadius="21"
                                    Margin="0,0,10,0">

                                <TextBlock Text="♥"
                                           FontSize="21"
                                           Foreground="#0A8267"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <TextBlock Text="VolunteerHub"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                        <TextBlock Text="Make an impact."
                                   Margin="51,3,0,0"
                                   FontSize="12"
                                   Foreground="#B3D8CE"/>

                    </StackPanel>


                    <Button Style="{StaticResource NavButtonStyle}"
                            Click="BackButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE721;"
                                       FontSize="20"
                                       Width="35"/>

                            <TextBlock Text="Events"/>

                        </StackPanel>

                    </Button>


                    <Button Height="48"
                            Margin="0,0,0,8"
                            Background="#16856E"
                            Foreground="White"
                            BorderThickness="0">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="11"
                                        Padding="14,0">

                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">

                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE946;"
                                                   FontSize="20"
                                                   Width="35"/>

                                        <TextBlock Text="Event details"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                    </Button>

                </StackPanel>


                <Button Grid.Row="2"
                        Height="48"
                        Background="#06392E"
                        Foreground="White"
                        BorderBrush="#3D8774"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="BackButton_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">

                            <Border x:Name="BackBackground"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE72B;"
                                               FontSize="18"
                                               Margin="0,0,9,0"/>

                                    <TextBlock Text="Back to events"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>

                                </StackPanel>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver"
                                         Value="True">

                                    <Setter TargetName="BackBackground"
                                            Property="Background"
                                            Value="#042E25"/>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Button.Template>

                </Button>

            </Grid>

        </Border>


        <!-- MAIN -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="34,28,34,28">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- HERO -->
                <Border Height="150"
                        CornerRadius="18"
                        ClipToBounds="True">

                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="18"
                            ShadowDepth="3"
                            Opacity="0.09"/>
                    </Border.Effect>


                    <Grid>

                        <Border>
                            <Border.Background>

                                <ImageBrush ImageSource="/Assets/findEvents.jpg.jpg"
                                            Stretch="UniformToFill"
                                            AlignmentY="Center"/>

                            </Border.Background>
                        </Border>


                        <Border>
                            <Border.Background>

                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="1,0">

                                    <GradientStop Color="#EC064E3B"
                                                  Offset="0"/>

                                    <GradientStop Color="#B8064E3B"
                                                  Offset="0.55"/>

                                    <GradientStop Color="#22064E3B"
                                                  Offset="1"/>

                                </LinearGradientBrush>

                            </Border.Background>
                        </Border>


                        <StackPanel Margin="30,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock x:Name="TitleText"
                                       Text="Event title"
                                       FontSize="31"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       TextWrapping="Wrap"/>

                            <Border Background="#DDF2EA"
                                    CornerRadius="12"
                                    HorizontalAlignment="Left"
                                    Padding="12,5"
                                    Margin="0,10,0,0">

                                <TextBlock x:Name="CategoryText"
                                           Text="Category"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#087A61"/>

                            </Border>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- DETAILS -->
                <Grid Grid.Row="1"
                      Margin="0,22,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>


                    <!-- LEFT DETAILS -->
                    <Border Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            Padding="25">

                        <StackPanel>

                            <TextBlock Text="About this event"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#12382F"/>

                            <TextBlock x:Name="DescriptionText"
                                       Margin="0,8,0,24"
                                       Foreground="#52635D"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       LineHeight="21"/>


                            <!-- DATE + TIME -->
                            <Grid Margin="0,0,0,18">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <Border Background="#F3F8F5"
                                        CornerRadius="12"
                                        Padding="16"
                                        Margin="0,0,8,0">

                                    <StackPanel>

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                       Text="&#xE787;"
                                                       FontSize="18"
                                                       Foreground="#087A61"
                                                       Margin="0,0,8,0"/>

                                            <TextBlock Text="Date"
                                                       FontWeight="Bold"
                                                       Foreground="#30483F"/>

                                        </StackPanel>

                                        <TextBlock x:Name="DateText"
                                                   Margin="26,6,0,0"
                                                   Foreground="#6B7B75"/>

                                    </StackPanel>

                                </Border>


                                <Border Grid.Column="1"
                                        Background="#F3F8F5"
                                        CornerRadius="12"
                                        Padding="16"
                                        Margin="8,0,0,0">

                                    <StackPanel>

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                       Text="&#xE917;"
                                                       FontSize="18"
                                                       Foreground="#087A61"
                                                       Margin="0,0,8,0"/>

                                            <TextBlock Text="Time"
                                                       FontWeight="Bold"
                                                       Foreground="#30483F"/>

                                        </StackPanel>

                                        <TextBlock x:Name="TimeText"
                                                   Margin="26,6,0,0"
                                                   Foreground="#6B7B75"/>

                                    </StackPanel>

                                </Border>

                            </Grid>


                            <!-- LOCATION ONLY -->
                            <Border Background="#F3F8F5"
                                    CornerRadius="12"
                                    Padding="16">

                                <StackPanel>

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE707;"
                                                   FontSize="18"
                                                   Foreground="#087A61"
                                                   Margin="0,0,8,0"/>

                                        <TextBlock Text="Location / address"
                                                   FontWeight="Bold"
                                                   Foreground="#30483F"/>

                                    </StackPanel>

                                    <TextBlock x:Name="LocationText"
                                               Margin="26,6,0,0"
                                               Foreground="#6B7B75"
                                               TextWrapping="Wrap"/>

                                </StackPanel>

                            </Border>


                            <Button Content="View location on Google Maps"
                                    Margin="0,18,0,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="ViewMapButton_Click"/>

                        </StackPanel>

                    </Border>


                    <!-- RIGHT ACTION CARD -->
                    <Border Grid.Column="2"
                            Style="{StaticResource CardStyle}"
                            Padding="22">

                        <StackPanel>

                            <Border Height="130"
                                    CornerRadius="14"
                                    ClipToBounds="True">

                                <Border.Background>
                                    <ImageBrush ImageSource="/Assets/upcomingEvents.jpg.jpg"
                                                Stretch="UniformToFill"/>
                                </Border.Background>

                            </Border>


                            <TextBlock Text="Registration"
                                       Margin="0,18,0,0"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="#12382F"/>


                            <Border Background="#F3F8F5"
                                    CornerRadius="12"
                                    Padding="16"
                                    Margin="0,12,0,16">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="Available places"
                                                   FontWeight="Bold"
                                                   Foreground="#30483F"/>

                                        <TextBlock Text="Current registrations"
                                                   Margin="0,4,0,0"
                                                   FontSize="11"
                                                   Foreground="#7A8984"/>

                                    </StackPanel>

                                    <TextBlock x:Name="PlacesText"
                                               Grid.Column="1"
                                               Text="0 / 0"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#087A61"
                                               VerticalAlignment="Center"/>

                                </Grid>

                            </Border>


                            <TextBlock x:Name="StatusText"
                                       Text=""
                                       Margin="0,0,0,12"
                                       FontWeight="SemiBold"
                                       Foreground="#087A61"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>


                            <Button x:Name="SignUpButton"
                                    Content="Sign up for this event"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="SignUpButton_Click"/>


                            <Button x:Name="CancelRegistrationButton"
                                    Content="Cancel registration"
                                    Height="44"
                                    Margin="0,10,0,0"
                                    Background="#FEE2E2"
                                    Foreground="#991B1B"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Visibility="Collapsed"
                                    Click="CancelRegistrationButton_Click"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- BOTTOM NOTE -->
                <Border Grid.Row="2"
                        Margin="0,20,0,0"
                        Background="#EEF8F3"
                        CornerRadius="16"
                        Padding="18">

                    <StackPanel Orientation="Horizontal">

                        <Border Width="38"
                                Height="38"
                                CornerRadius="19"
                                Background="#D7F0E5"
                                Margin="0,0,12,0">

                            <TextBlock Text="♥"
                                       FontSize="18"
                                       Foreground="#087A61"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>


                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="Thank you for making a difference."
                                       FontWeight="Bold"
                                       Foreground="#23453A"/>

                            <TextBlock Text="Every volunteer hour contributes to a stronger community."
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="#75847F"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

            </Grid>

        </ScrollViewer>

    </Grid>

</Window>