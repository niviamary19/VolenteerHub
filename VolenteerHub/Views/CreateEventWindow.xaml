<Window x:Class="VolenteerHub.Views.CreateEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VolunteerHub - Create Event"
        Height="760"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F7FB">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Border Background="#1F4F46">

            <StackPanel Margin="30"
                        VerticalAlignment="Center">

                <TextBlock Text="VolunteerHub"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,25"/>

                <TextBlock Text="Create an event"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#DDEFEA"
                           Margin="0,0,0,15"/>

                <TextBlock Text="Add a new volunteering opportunity for people in your community."
                           FontSize="15"
                           Foreground="White"
                           TextWrapping="Wrap"
                           LineHeight="23"/>

            </StackPanel>

        </Border>

        <!-- FORM -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto">

            <Border Width="610"
                    Margin="35"
                    Padding="35"
                    Background="White"
                    CornerRadius="18"
                    HorizontalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="New volunteer event"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#1F2937"/>

                    <TextBlock Text="Fill in the details below."
                               Margin="0,7,0,25"
                               Foreground="#6B7280"/>

                    <!-- TITLE -->
                    <TextBlock Text="Event title"
                               FontWeight="SemiBold"/>

                    <TextBox x:Name="TitleTextBox"
                             Height="40"
                             Padding="10"
                             Margin="0,7,0,15"/>

                    <!-- DESCRIPTION -->
                    <TextBlock Text="Description"
                               FontWeight="SemiBold"/>

                    <TextBox x:Name="DescriptionTextBox"
                             Height="80"
                             Padding="10"
                             Margin="0,7,0,15"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>

                    <!-- DATE -->
                    <TextBlock Text="Date"
                               FontWeight="SemiBold"/>

                    <DatePicker x:Name="EventDatePicker"
                                Height="40"
                                Margin="0,7,0,15"
                                SelectedDateFormat="Short"/>

                    <!-- TIMES -->
                    <Grid Margin="0,0,0,15">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Start time"
                                       FontWeight="SemiBold"/>

                            <TextBox x:Name="StartTimeTextBox"
                                     Height="40"
                                     Padding="10"
                                     Margin="0,7,0,0"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="End time"
                                       FontWeight="SemiBold"/>

                            <TextBox x:Name="EndTimeTextBox"
                                     Height="40"
                                     Padding="10"
                                     Margin="0,7,0,0"/>

                        </StackPanel>

                    </Grid>

                    <TextBlock Text="Example: 09:00 or 14:30"
                               FontSize="12"
                               Foreground="#6B7280"
                               Margin="0,-8,0,15"/>

                    <!-- CATEGORY -->
                    <TextBlock Text="Category"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="CategoryComboBox"
                              Height="40"
                              Margin="0,7,0,15"
                              SelectedIndex="0">

                        <ComboBoxItem Content="Community"/>
                        <ComboBoxItem Content="Environment"/>
                        <ComboBoxItem Content="Animals"/>
                        <ComboBoxItem Content="Education"/>
                        <ComboBoxItem Content="Healthcare"/>
                        <ComboBoxItem Content="Food"/>
                        <ComboBoxItem Content="Other"/>

                    </ComboBox>

                    <!-- LOCATION -->
                    <TextBlock Text="Location"
                               FontWeight="SemiBold"/>

                    <TextBox x:Name="LocationTextBox"
                             Height="40"
                             Padding="10"
                             Margin="0,7,0,15"/>

                    <!-- COORDINATES -->
                    <Grid Margin="0,0,0,15">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Latitude"
                                       FontWeight="SemiBold"/>

                            <TextBox x:Name="LatitudeTextBox"
                                     Height="40"
                                     Padding="10"
                                     Margin="0,7,0,0"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Longitude"
                                       FontWeight="SemiBold"/>

                            <TextBox x:Name="LongitudeTextBox"
                                     Height="40"
                                     Padding="10"
                                     Margin="0,7,0,0"/>

                        </StackPanel>

                    </Grid>

                    <TextBlock Text="Example Brussels: 50.8503 / 4.3517"
                               FontSize="12"
                               Foreground="#6B7280"
                               Margin="0,-8,0,15"/>

                    <!-- MAX VOLUNTEERS -->
                    <TextBlock Text="Maximum volunteers"
                               FontWeight="SemiBold"/>

                    <TextBox x:Name="MaxVolunteersTextBox"
                             Height="40"
                             Padding="10"
                             Margin="0,7,0,25"/>

                    <!-- BUTTONS -->
                    <Button Content="Create event"
                            Height="45"
                            Background="#2E7D6E"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CreateEventButton_Click"/>

                    <Button Content="Cancel"
                            Height="40"
                            Margin="0,10,0,0"
                            Background="Transparent"
                            Foreground="#6B7280"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CancelButton_Click"/>

                </StackPanel>

            </Border>

        </ScrollViewer>

    </Grid>

</Window>