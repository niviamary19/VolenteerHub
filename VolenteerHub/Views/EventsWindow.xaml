<Window x:Class="VolenteerHub.Views.EventsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VolunteerHub - Events"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F7FB">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Background="#1F4F46">

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>

                    <TextBlock Text="VolunteerHub"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,10,0,40"/>

                    <Button Content="Dashboard"
                            Height="45"
                            Margin="0,0,0,10"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Cursor="Hand"
                            Click="DashboardButton_Click"/>

                    <Button Content="Events"
                            Height="45"
                            Margin="0,0,0,10"
                            Background="#2E7D6E"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"/>

                </StackPanel>

                <Button Grid.Row="2"
                        Content="Back to dashboard"
                        Height="45"
                        Background="#173B35"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="DashboardButton_Click"/>

            </Grid>

        </Border>

        <!-- CONTENT -->
        <Grid Grid.Column="1"
              Margin="35">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel>

                <TextBlock Text="Volunteer Events"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#1F2937"/>

                <TextBlock Text="Browse upcoming volunteering opportunities."
                           Margin="0,5,0,0"
                           FontSize="15"
                           Foreground="#6B7280"/>

            </StackPanel>

            <!-- SEARCH -->
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="18"
                    Margin="0,25,0,20">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchTextBox"
                             Height="40"
                             Padding="10"
                             FontSize="14"
                             VerticalContentAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="Search"
                            Margin="15,0,0,0"
                            Background="#2E7D6E"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="SearchButton_Click"/>

                </Grid>

            </Border>

            <!-- EVENTS -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="15"
                    Padding="20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ResultText"
                               Text="Available events"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#1F2937"
                               Margin="0,0,0,15"/>

                    <DataGrid x:Name="EventsDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="42">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Title"
                                                Binding="{Binding Title}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding EventDate}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Time"
                                                Binding="{Binding StartTime}"
                                                Width="80"/>

                            <DataGridTextColumn Header="Category"
                                                Binding="{Binding Category}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Location"
                                                Binding="{Binding Location}"
                                                Width="150"/>

                            <DataGridTextColumn Header="Places"
                                                Binding="{Binding MaxVolunteers}"
                                                Width="80"/>

                        </DataGrid.Columns>

                    </DataGrid>

                    <Button Grid.Row="2"
                            Content="View selected event"
                            Width="190"
                            Height="42"
                            Margin="0,18,0,0"
                            HorizontalAlignment="Right"
                            Background="#2E7D6E"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="ViewEventButton_Click"/>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>