<Window x:Class="VolenteerHub.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VolunteerHub - Dashboard"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F7FB">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Background="#1F4F46">

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>

                    <TextBlock Text="VolunteerHub"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,10,0,40"/>

                    <Button Content="Dashboard"
                            Height="45"
                            Margin="0,0,0,10"
                            Background="#2E7D6E"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"/>

                    <Button Content="Calendar"
                            Height="45"
                            Margin="0,0,0,10"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Cursor="Hand"
                            Click="CalendarButton_Click"/>

                    <Button Content="Events"
                            Height="45"
                            Margin="0,0,0,10"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Cursor="Hand"
                            Click="EventsButton_Click"/>

                    <Button Content="My Hours"
                            Height="45"
                            Margin="0,0,0,10"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Cursor="Hand"
                            Click="MyHoursButton_Click"/>

                    <Button Content="Profile"
                            Height="45"
                            Margin="0,0,0,10"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Cursor="Hand"
                            Click="ProfileButton_Click"/>

                    <Button x:Name="CreateEventButton"
                            Content="Create Event"
                            Height="45"
                            Margin="0,0,0,10"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Click="CreateEventButton_Click"/>

                    <Button x:Name="ManageEventsButton"
                            Content="Manage Events"
                            Height="45"
                            Margin="0,0,0,10"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Click="ManageEventsButton_Click"/>

                </StackPanel>

                <Button Grid.Row="2"
                        Content="Log out"
                        Height="45"
                        Background="#173B35"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="LogoutButton_Click"/>

            </Grid>

        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1"
              Margin="35">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock x:Name="WelcomeText"
                               Text="Welcome back!"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#1F2937"/>

                    <TextBlock x:Name="RoleText"
                               Text="Volunteer"
                               Margin="0,5,0,0"
                               FontSize="15"
                               Foreground="#6B7280"/>

                </StackPanel>

                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="12"
                        Padding="18,10">

                    <StackPanel>

                        <TextBlock x:Name="UserNameText"
                                   FontWeight="Bold"
                                   Foreground="#1F2937"/>

                        <TextBlock x:Name="UserEmailText"
                                   FontSize="12"
                                   Foreground="#6B7280"/>

                    </StackPanel>

                </Border>

            </Grid>

            <Grid Grid.Row="1"
                  Margin="0,35,0,30">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="White"
                        CornerRadius="15"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Upcoming events"
                                   Foreground="#6B7280"/>

                        <TextBlock x:Name="UpcomingEventsCountText"
                                   Text="0"
                                   Margin="0,8,0,0"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#1F2937"/>

                    </StackPanel>

                </Border>

                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="15"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Volunteer hours"
                                   Foreground="#6B7280"/>

                        <TextBlock x:Name="VolunteerHoursText"
                                   Text="0 h"
                                   Margin="0,8,0,0"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#1F2937"/>

                    </StackPanel>

                </Border>

                <Border Grid.Column="4"
                        Background="White"
                        CornerRadius="15"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Joined events"
                                   Foreground="#6B7280"/>

                        <TextBlock x:Name="JoinedEventsCountText"
                                   Text="0"
                                   Margin="0,8,0,0"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#1F2937"/>

                    </StackPanel>

                </Border>

            </Grid>

            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="15"
                    Padding="25">

                <StackPanel>

                    <TextBlock Text="Discover opportunities"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#1F2937"/>

                    <TextBlock Text="Browse events, use the monthly calendar or view your volunteering history."
                               Margin="0,8,0,22"
                               Foreground="#6B7280"/>

                    <StackPanel Orientation="Horizontal">

                        <Button Content="Calendar"
                                Width="140"
                                Height="42"
                                Background="#1F4F46"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="CalendarButton_Click"/>

                        <Button Content="Browse Events"
                                Width="150"
                                Height="42"
                                Margin="12,0,0,0"
                                Background="#2E7D6E"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="EventsButton_Click"/>

                        <Button Content="My Volunteering"
                                Width="160"
                                Height="42"
                                Margin="12,0,0,0"
                                Background="#DDEFEA"
                                Foreground="#1F4F46"
                                BorderThickness="0"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="MyHoursButton_Click"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>