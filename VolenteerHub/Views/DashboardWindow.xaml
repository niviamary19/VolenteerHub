<Window x:Class="VolenteerHub.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VolunteerHub - Dashboard"
        Height="780"
        Width="1250"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F6F9F7">

    <Window.Resources>

        <!-- ================================================= -->
        <!-- SIDEBAR                                          -->
        <!-- ================================================= -->

        <LinearGradientBrush x:Key="SidebarGradient"
                             StartPoint="0,0"
                             EndPoint="0,1">
            <GradientStop Color="#064E3B"
                          Offset="0"/>
            <GradientStop Color="#075D49"
                          Offset="0.55"/>
            <GradientStop Color="#054333"
                          Offset="1"/>
        </LinearGradientBrush>


        <!-- ================================================= -->
        <!-- NAVIGATION BUTTON                                -->
        <!-- ================================================= -->

        <Style x:Key="NavButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="Margin"
                    Value="0,0,0,8"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#F1F8F5"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="NavBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="14,0">

                            <ContentPresenter
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="NavBackground"
                                        Property="Background"
                                        Value="#137961"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ================================================= -->
        <!-- GREEN BUTTON                                     -->
        <!-- ================================================= -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="Background"
                    Value="#087A61"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="PrimaryBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="PrimaryBackground"
                                        Property="Background"
                                        Value="#05624E"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ================================================= -->
        <!-- SHADOW                                           -->
        <!-- ================================================= -->

        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="CornerRadius"
                    Value="18"/>

            <Setter Property="Effect">

                <Setter.Value>

                    <DropShadowEffect
                        BlurRadius="18"
                        ShadowDepth="3"
                        Opacity="0.07"/>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ================================================= -->
        <!-- SIDEBAR                                          -->
        <!-- ================================================= -->

        <Border Background="{StaticResource SidebarGradient}">

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <StackPanel>

                    <!-- LOGO -->

                    <StackPanel Margin="5,18,0,35">

                        <StackPanel Orientation="Horizontal">

                            <Border Width="42"
                                    Height="42"
                                    Background="#ECF8F4"
                                    CornerRadius="21"
                                    Margin="0,0,10,0">

                                <TextBlock Text="♥"
                                           FontSize="21"
                                           Foreground="#0A8267"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>


                            <TextBlock Text="VolunteerHub"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                        </StackPanel>


                        <TextBlock Text="Make an impact."
                                   Margin="51,3,0,0"
                                   FontSize="12"
                                   Foreground="#B3D8CE"/>

                    </StackPanel>


                    <!-- DASHBOARD ACTIVE -->

                    <Button Height="48"
                            Margin="0,0,0,8"
                            Background="#16856E"
                            Foreground="White"
                            BorderThickness="0">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="11"
                                        Padding="14,0">

                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">

                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE80F;"
                                                   FontSize="20"
                                                   Width="35"/>

                                        <TextBlock Text="Dashboard"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>


                    <!-- CALENDAR -->

                    <Button Style="{StaticResource NavButtonStyle}"
                            Click="CalendarButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE787;"
                                       FontSize="20"
                                       Width="35"/>

                            <TextBlock Text="Calendar"/>

                        </StackPanel>

                    </Button>


                    <!-- EVENTS -->

                    <Button Style="{StaticResource NavButtonStyle}"
                            Click="EventsButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE721;"
                                       FontSize="20"
                                       Width="35"/>

                            <TextBlock Text="Events"/>

                        </StackPanel>

                    </Button>


                    <!-- HOURS -->

                    <Button Style="{StaticResource NavButtonStyle}"
                            Click="MyHoursButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE823;"
                                       FontSize="20"
                                       Width="35"/>

                            <TextBlock Text="My Hours"/>

                        </StackPanel>

                    </Button>


                    <!-- PROFILE -->

                    <Button Style="{StaticResource NavButtonStyle}"
                            Click="ProfileButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE77B;"
                                       FontSize="20"
                                       Width="35"/>

                            <TextBlock Text="Profile"/>

                        </StackPanel>

                    </Button>


                    <Border Height="1"
                            Background="#397767"
                            Margin="6,14,6,15"/>


                    <!-- CREATE EVENT -->

                    <Button x:Name="CreateEventButton"
                            Style="{StaticResource NavButtonStyle}"
                            Visibility="Collapsed"
                            Click="CreateEventButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE109;"
                                       FontSize="20"
                                       Width="35"/>

                            <TextBlock Text="Create Event"/>

                        </StackPanel>

                    </Button>


                    <!-- MANAGE EVENTS -->

                    <Button x:Name="ManageEventsButton"
                            Style="{StaticResource NavButtonStyle}"
                            Visibility="Collapsed"
                            Click="ManageEventsButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE713;"
                                       FontSize="20"
                                       Width="35"/>

                            <TextBlock Text="Manage Events"/>

                        </StackPanel>

                    </Button>

                </StackPanel>


                <!-- LOGOUT -->

                <Button Grid.Row="2"
                        Height="48"
                        Background="#06392E"
                        Foreground="White"
                        BorderBrush="#3D8774"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="LogoutButton_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="LogoutBackground"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE8AC;"
                                               FontSize="19"
                                               Margin="0,0,10,0"/>

                                    <TextBlock Text="Log out"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>

                                </StackPanel>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver"
                                         Value="True">

                                    <Setter TargetName="LogoutBackground"
                                            Property="Background"
                                            Value="#042E25"/>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Button.Template>

                </Button>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- MAIN CONTENT                                     -->
        <!-- ================================================= -->

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="34,26,34,28">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- HEADER                                           -->
                <!-- ================================================= -->

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel VerticalAlignment="Center">

                        <TextBlock x:Name="WelcomeText"
                                   Text="Welcome back!"
                                   FontSize="31"
                                   FontWeight="Bold"
                                   Foreground="#082F27"/>


                        <StackPanel Orientation="Horizontal"
                                    Margin="3,7,0,0">

                            <Ellipse Width="9"
                                     Height="9"
                                     Fill="#67B58F"
                                     VerticalAlignment="Center"
                                     Margin="0,0,10,0"/>

                            <TextBlock x:Name="RoleText"
                                       Text="Logged in as Volunteer"
                                       FontSize="14"
                                       Foreground="#76857F"/>

                        </StackPanel>

                    </StackPanel>


                    <!-- PROFILE CARD -->

                    <Border Grid.Column="1"
                            Width="250"
                            Height="76"
                            Background="White"
                            CornerRadius="17"
                            Padding="14">

                        <Border.Effect>

                            <DropShadowEffect
                                BlurRadius="18"
                                ShadowDepth="3"
                                Opacity="0.08"/>

                        </Border.Effect>


                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <!-- GENERIC PROFILE ICON -->

                            <Border Width="50"
                                    Height="50"
                                    CornerRadius="25"
                                    Background="#DDF2EA"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">

                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE77B;"
                                           FontSize="27"
                                           Foreground="#078067"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>


                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">

                                <TextBlock x:Name="UserNameText"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#12372E"/>

                                <TextBlock x:Name="UserEmailText"
                                           FontSize="10"
                                           Margin="0,4,0,0"
                                           Foreground="#84928D"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- TOP CARDS                                        -->
                <!-- ================================================= -->

                <Grid Grid.Row="1"
                      Margin="0,28,0,22">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="17"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="17"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- UPCOMING EVENTS -->

                    <Border Grid.Column="0"
                            Height="160"
                            Style="{StaticResource CardStyle}">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="125"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel Margin="22"
                                        VerticalAlignment="Center">

                                <TextBlock Text="UPCOMING EVENTS"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#087A61"/>


                                <StackPanel Orientation="Horizontal"
                                            Margin="0,10,0,0">

                                    <Border Width="41"
                                            Height="41"
                                            CornerRadius="21"
                                            Background="#D8F2E6"
                                            Margin="0,0,13,0">

                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE787;"
                                                   FontSize="20"
                                                   Foreground="#087A61"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>


                                    <TextBlock x:Name="UpcomingEventsCountText"
                                               Text="0"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               Foreground="#0A372E"
                                               VerticalAlignment="Center"/>

                                </StackPanel>


                                <TextBlock Text="Events ahead"
                                           Margin="54,4,0,0"
                                           FontSize="11"
                                           Foreground="#72827D"/>

                            </StackPanel>


                            <Border Grid.Column="1"
                                    CornerRadius="62,18,18,62">

                                <Border.Background>

                                    <ImageBrush ImageSource="/Assets/upcomingEvents.jpg.jpg"
                                                Stretch="UniformToFill"/>

                                </Border.Background>

                            </Border>

                        </Grid>

                    </Border>


                    <!-- HOURS -->

                    <Border Grid.Column="2"
                            Height="160"
                            Style="{StaticResource CardStyle}">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="125"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel Margin="22"
                                        VerticalAlignment="Center">

                                <TextBlock Text="VOLUNTEER HOURS"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#DD8B13"/>


                                <StackPanel Orientation="Horizontal"
                                            Margin="0,10,0,0">

                                    <Border Width="41"
                                            Height="41"
                                            CornerRadius="21"
                                            Background="#FFECCD"
                                            Margin="0,0,13,0">

                                        <TextBlock Text="★"
                                                   FontSize="20"
                                                   Foreground="#E69A20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>


                                    <TextBlock x:Name="VolunteerHoursText"
                                               Text="0 h"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               Foreground="#0A372E"
                                               VerticalAlignment="Center"/>

                                </StackPanel>


                                <TextBlock Text="Your total impact"
                                           Margin="54,4,0,0"
                                           FontSize="11"
                                           Foreground="#72827D"/>

                            </StackPanel>


                            <Border Grid.Column="1"
                                    CornerRadius="62,18,18,62">

                                <Border.Background>

                                    <ImageBrush ImageSource="/Assets/samenwerking.jpg.jpg"
                                                Stretch="UniformToFill"/>

                                </Border.Background>

                            </Border>

                        </Grid>

                    </Border>


                    <!-- JOINED EVENTS -->

                    <Border Grid.Column="4"
                            Height="160"
                            Style="{StaticResource CardStyle}">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="125"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel Margin="22"
                                        VerticalAlignment="Center">

                                <TextBlock Text="JOINED EVENTS"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#2478A8"/>


                                <StackPanel Orientation="Horizontal"
                                            Margin="0,10,0,0">

                                    <Border Width="41"
                                            Height="41"
                                            CornerRadius="21"
                                            Background="#DCEEF7"
                                            Margin="0,0,13,0">

                                        <TextBlock Text="✓"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="#2478A8"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>


                                    <TextBlock x:Name="JoinedEventsCountText"
                                               Text="0"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               Foreground="#0A372E"
                                               VerticalAlignment="Center"/>

                                </StackPanel>


                                <TextBlock Text="Events you've joined"
                                           Margin="54,4,0,0"
                                           FontSize="11"
                                           Foreground="#72827D"/>

                            </StackPanel>


                            <Border Grid.Column="1"
                                    CornerRadius="62,18,18,62">

                                <Border.Background>

                                    <ImageBrush ImageSource="/Assets/joinedEvent.jpg.jpg"
                                                Stretch="UniformToFill"/>

                                </Border.Background>

                            </Border>

                        </Grid>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- DISCOVER OPPORTUNITIES                            -->
                <!-- ================================================= -->

                <Border Grid.Row="2"
                        Style="{StaticResource CardStyle}"
                        Padding="25">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <StackPanel>

                            <TextBlock Text="Discover opportunities"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       Foreground="#11382F"/>

                            <TextBlock Text="Ready to make a difference? Explore volunteer opportunities and keep track of your impact."
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="#778782"/>

                        </StackPanel>


                        <Grid Grid.Row="1"
                              Margin="0,20,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <!-- CALENDAR -->

                            <Border Grid.Column="0"
                                    Height="188"
                                    Background="#F4FAF7"
                                    CornerRadius="15">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>


                                    <StackPanel Margin="18">

                                        <Border Width="40"
                                                Height="40"
                                                CornerRadius="20"
                                                Background="#087A61"
                                                HorizontalAlignment="Left">

                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                       Text="&#xE787;"
                                                       FontSize="20"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                        </Border>


                                        <TextBlock Text="Calendar"
                                                   Margin="0,10,0,0"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#13382F"/>


                                        <TextBlock Text="View upcoming opportunities by date."
                                                   Margin="0,4,0,11"
                                                   FontSize="10"
                                                   Foreground="#73837E"
                                                   TextWrapping="Wrap"/>


                                        <Button Content="Open Calendar"
                                                Width="120"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="CalendarButton_Click"/>

                                    </StackPanel>


                                    <Border Grid.Column="1"
                                            CornerRadius="50,15,15,50">

                                        <Border.Background>

                                            <ImageBrush ImageSource="/Assets/kalender.jpg.jpg"
                                                        Stretch="UniformToFill"/>

                                        </Border.Background>

                                    </Border>

                                </Grid>

                            </Border>


                            <!-- FIND EVENTS -->

                            <Border Grid.Column="2"
                                    Height="188"
                                    Background="#F4FAF7"
                                    CornerRadius="15">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>


                                    <StackPanel Margin="18">

                                        <Border Width="40"
                                                Height="40"
                                                CornerRadius="20"
                                                Background="#087A61"
                                                HorizontalAlignment="Left">

                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                       Text="&#xE721;"
                                                       FontSize="20"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                        </Border>


                                        <TextBlock Text="Find events"
                                                   Margin="0,10,0,0"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#13382F"/>


                                        <TextBlock Text="Browse and discover volunteer events."
                                                   Margin="0,4,0,11"
                                                   FontSize="10"
                                                   Foreground="#73837E"
                                                   TextWrapping="Wrap"/>


                                        <Button Content="Browse Events"
                                                Width="120"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="EventsButton_Click"/>

                                    </StackPanel>


                                    <Border Grid.Column="1"
                                            CornerRadius="50,15,15,50">

                                        <Border.Background>

                                            <ImageBrush ImageSource="/Assets/findEvents.jpg.jpg"
                                                        Stretch="UniformToFill"/>

                                        </Border.Background>

                                    </Border>

                                </Grid>

                            </Border>


                            <!-- YOUR IMPACT -->

                            <Border Grid.Column="4"
                                    Height="188"
                                    Background="#F4FAF7"
                                    CornerRadius="15">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>


                                    <StackPanel Margin="18">

                                        <Border Width="40"
                                                Height="40"
                                                CornerRadius="20"
                                                Background="#087A61"
                                                HorizontalAlignment="Left">

                                            <TextBlock Text="♡"
                                                       FontSize="22"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                        </Border>


                                        <TextBlock Text="Your impact"
                                                   Margin="0,10,0,0"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#13382F"/>


                                        <TextBlock Text="See your volunteering history and hours."
                                                   Margin="0,4,0,11"
                                                   FontSize="10"
                                                   Foreground="#73837E"
                                                   TextWrapping="Wrap"/>


                                        <Button Content="View My Hours"
                                                Width="120"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="MyHoursButton_Click"/>

                                    </StackPanel>


                                    <Border Grid.Column="1"
                                            CornerRadius="50,15,15,50">

                                        <Border.Background>

                                            <ImageBrush ImageSource="/Assets/yourImpact.jpg.jpg"
                                                        Stretch="UniformToFill"/>

                                        </Border.Background>

                                    </Border>

                                </Grid>

                            </Border>

                        </Grid>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- QUOTE                                            -->
                <!-- ================================================= -->

                <Border Grid.Row="3"
                        Height="108"
                        Margin="0,18,0,0"
                        Background="White"
                        CornerRadius="17">

                    <Border.Effect>

                        <DropShadowEffect
                            BlurRadius="15"
                            ShadowDepth="2"
                            Opacity="0.06"/>

                    </Border.Effect>


                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="340"/>
                        </Grid.ColumnDefinitions>


                        <!-- EARTH -->

                        <Border Width="88"
                                Height="88"
                                CornerRadius="44"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                            <Border.Background>

                                <ImageBrush ImageSource="/Assets/aarde.jpg.jpg"
                                            Stretch="UniformToFill"/>

                            </Border.Background>

                        </Border>


                        <!-- QUOTE TEXT -->

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="&quot;"
                                           FontSize="38"
                                           FontWeight="Bold"
                                           Foreground="#6DB68D"
                                           Margin="0,-10,10,0"/>


                                <TextBlock FontSize="13"
                                           Foreground="#23433A"
                                           LineHeight="20">

                                    <Run Text="The best way to find yourself is to lose yourself"/>

                                    <LineBreak/>

                                    <Run Text="in the service of others."/>

                                </TextBlock>

                            </StackPanel>


                            <TextBlock Text="- Mahatma Gandhi"
                                       Margin="39,3,0,0"
                                       FontSize="11"
                                       Foreground="#087A61"/>

                        </StackPanel>


                        <!-- RIGHT IMAGE -->

                        <Border Grid.Column="2"
                                Margin="8,10,10,10"
                                CornerRadius="40,16,16,40"
                                ClipToBounds="True">

                            <Border.Background>

                                <ImageBrush ImageSource="/Assets/volunteer.jpg.jpg"
                                            Stretch="Uniform"
                                            AlignmentX="Center"
                                            AlignmentY="Center"/>

                            </Border.Background>

