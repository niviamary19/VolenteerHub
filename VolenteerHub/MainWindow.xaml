<Window x:Class="VolenteerHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VolunteerHub"
        Height="620"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F7FB">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="0.9*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE -->
        <Border Background="#2E7D6E">
            <Grid>
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Width="350">

                    <TextBlock Text="VolunteerHub"
                               FontSize="42"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Make a difference. Track your impact."
                               Margin="0,15,0,0"
                               FontSize="18"
                               Foreground="#DDEFEA"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Find volunteer events, sign up and keep track of your volunteering hours."
                               Margin="0,25,0,0"
                               FontSize="15"
                               Foreground="White"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RIGHT SIDE -->
        <Grid Grid.Column="1">

            <Border Width="360"
                    Padding="35"
                    Background="White"
                    CornerRadius="18"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="Welcome back"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#1F2937"/>

                    <TextBlock Text="Log in to your VolunteerHub account"
                               Margin="0,8,0,30"
                               Foreground="#6B7280"
                               FontSize="14"/>

                    <TextBlock Text="Email"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>

                    <TextBox x:Name="EmailTextBox"
                             Height="42"
                             Margin="0,8,0,18"
                             Padding="10"
                             FontSize="14"/>

                    <TextBlock Text="Password"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>

                    <PasswordBox x:Name="PasswordInput"
                                 Height="42"
                                 Margin="0,8,0,25"
                                 Padding="10"
                                 FontSize="14"/>

                    <Button x:Name="LoginButton"
                            Content="Log in"
                            Height="45"
                            Background="#2E7D6E"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="15"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="LoginButton_Click"/>

                    <StackPanel Margin="0,25,0,0"
                                HorizontalAlignment="Center">

                        <TextBlock Text="Don't have an account?"
                                   HorizontalAlignment="Center"
                                   Foreground="#6B7280"/>

                        <Button Content="Create an account"
                                Margin="0,5,0,0"
                                Background="Transparent"
                                Foreground="#2E7D6E"
                                BorderThickness="0"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="RegisterButton_Click"/>

                    </StackPanel>

                </StackPanel>
            </Border>

        </Grid>

    </Grid>
</Window>